<?xml version="1.0" encoding="utf-8"?>
<!--
  Release build for users: one Apex.exe, win-x64, with the .NET runtime inside (nothing to install first).
  - Native libraries (SkiaSharp, HarfBuzz, ANGLE) are bundled and extracted on first launch.
  - ReadyToRun: Avalonia and Apex are precompiled, so startup doesn't wait on the JIT.
  - No trimming: Avalonia's XAML loader, compiled bindings and the deffile interpreter reflect over types the
    trimmer can't see, and nothing has proven a trimmed build safe.
  - Embedded PDBs, so crash logs carry file and line.
  Used by release.ps1 at the repo root.
-->
<Project>
  <PropertyGroup>
    <Configuration>Release</Configuration>
    <Platform>Any CPU</Platform>
    <RuntimeIdentifier>win-x64</RuntimeIdentifier>
    <SelfContained>true</SelfContained>
    <PublishSingleFile>true</PublishSingleFile>
    <IncludeNativeLibrariesForSelfExtract>true</IncludeNativeLibrariesForSelfExtract>
    <PublishReadyToRun>true</PublishReadyToRun>
    <PublishTrimmed>false</PublishTrimmed>
    <DebugType>embedded</DebugType>
    <SatelliteResourceLanguages>en</SatelliteResourceLanguages>
    <PublishDir>bin\publish\win-x64\</PublishDir>
    <PublishProtocol>FileSystem</PublishProtocol>
    <_TargetId>Folder</_TargetId>
  </PropertyGroup>
</Project>
