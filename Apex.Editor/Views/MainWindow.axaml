<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="using:Apex.Editor.ViewModels"
        xmlns:views="using:Apex.Editor.Views"
        xmlns:controls="using:Apex.Editor.Controls"
        xmlns:c="using:Apex.Editor.Commands"
        xmlns:svc="using:Apex.Editor.Services"
        xmlns:stock="using:Apex.Editor.Services.Stock"
        x:Class="Apex.Editor.Views.MainWindow"
        x:DataType="vm:MainViewModel"
        Title="{Binding WindowTitle}"
        Icon="/Assets/apex.ico"
        Width="1600" Height="1000"
        MinWidth="1100" MinHeight="640"
        WindowStartupLocation="CenterScreen"
        Background="{DynamicResource BgWindowBrush}"
        ExtendClientAreaToDecorationsHint="True"
        ExtendClientAreaTitleBarHeightHint="40">

  <!-- No key bindings here: every shortcut is a command in Commands/CommandCatalog.cs, dispatched by
       MainWindow.TryRunShortcut. -->

  <Panel>
  <!-- Mica tint: over the system backdrop when Mica is active (see code-behind); otherwise the
       window background above is the solid fallback and this layer is transparent. -->
  <Border Name="MicaTint" Background="Transparent"/>

  <Grid>

    <!-- ── Workspace: the Explorer sidebar sits on the window; the editor and its right column are one card ── -->
    <Grid Name="Workspace">
      <Grid.ColumnDefinitions>
        <ColumnDefinition Width="248" MinWidth="0"/>
        <ColumnDefinition Width="6"/>
        <ColumnDefinition Width="*"/>
      </Grid.ColumnDefinitions>

      <!-- Sidebar: identity and the session's verbs on top, the Explorer, and what just happened at the foot. -->
      <DockPanel Grid.Column="0" Name="Sidebar">
        <DockPanel DockPanel.Dock="Top" Name="TopBarLeft" Height="44" Margin="14,0,6,0" Background="Transparent" LastChildFill="False"
                   PointerPressed="TopBar_PointerPressed">
          <!-- The mark opens the app menu: what belongs to Apex rather than to the workspace (the theme, updates, about).
               It looks as it does at rest; only hover, press and focus show it's a button. First in the row, on screen and
               in Tab order. Without an install it is the mark alone, like the rest of the row. -->
          <Button Name="AppMenuButton" Classes="appmark" DockPanel.Dock="Left" VerticalAlignment="Center"
                  IsEnabled="{Binding !IsInstallMissing}"
                  AutomationProperties.Name="Apex" ToolTip.Tip="Theme, Radiant sync, updates and about Apex">
            <Button.Flyout>
              <MenuFlyout Placement="BottomEdgeAlignedLeft">
                <MenuItem c:Cmd.Id="view.themeSystem" ToggleType="Radio" GroupName="theme"/>
                <MenuItem c:Cmd.Id="view.themeGraphite" ToggleType="Radio" GroupName="theme"/>
                <MenuItem c:Cmd.Id="view.themeSlate" ToggleType="Radio" GroupName="theme"/>
                <MenuItem c:Cmd.Id="view.themeLight" ToggleType="Radio" GroupName="theme"/>
                <Separator/>
                <!-- APE's "Sync changes with Radiant and other applications": edits go to gdtDB\live\changes.log, saves run
                     gdtdb.exe /update (RadiantSync). Only with an install. -->
                <MenuItem c:Cmd.Id="app.syncRadiant" ToggleType="CheckBox"
                          ToolTip.Tip="Radiant and other tools hear about each change as you make it, and about each save"/>
                <Separator/>
                <!-- Updates: how the last check went, and Check now, which keeps the menu open and updates the line in
                     place. Blackbird's Help > Updates is its sibling; the copy is the shared Updater's. While there is
                     an update the line names it and opens the update control's flyout. -->
                <MenuItem Name="UpdatesMenu" Header="Updates">
                  <MenuItem Name="UpdateStatusItem" Classes="updatestatus" MinWidth="200"
                            Header="{Binding Updates.MenuStatus}"
                            IsEnabled="{Binding Updates.IsShown}"
                            Click="UpdateStatus_Click"
                            ToolTip.Tip="{Binding Updates.MenuStatusTip}" ToolTip.ShowOnDisabled="True">
                    <MenuItem.Icon>
                      <Panel>
                        <controls:GlyphIcon Classes="updateglyph" Glyph="check" Size="13" IsVisible="{Binding Updates.IsUpToDate}"/>
                        <controls:GlyphIcon Classes="updateglyph" Glyph="warning" Size="13" IsVisible="{Binding Updates.MenuShowsWarning}"/>
                        <controls:GlyphIcon Classes="updateglyph" Classes.pending="{Binding Updates.IsPending}" Glyph="arrow-down" Size="13"
                                            IsVisible="{Binding Updates.MenuShowsArrow}"/>
                      </Panel>
                    </MenuItem.Icon>
                  </MenuItem>
                  <MenuItem Name="CheckNowItem" Header="{Binding Updates.CheckNowText}"
                            Command="{Binding Updates.CheckNowCommand}" StaysOpenOnClick="True"
                            IsVisible="{Binding Updates.ShowsCheckNow}"/>
                </MenuItem>
                <MenuItem c:Cmd.Id="app.whatsNew"/>
                <MenuItem c:Cmd.Id="app.components"/>
                <MenuItem c:Cmd.Id="app.stockSounds"/>
                <Separator/>
                <MenuItem c:Cmd.Id="app.about"/>
              </MenuFlyout>
            </Button.Flyout>
            <!-- About Apex: the version and what Apex is, in the update control's flyout style. -->
            <FlyoutBase.AttachedFlyout>
              <Flyout Placement="BottomEdgeAlignedLeft">
                <StackPanel Name="AboutPanel" Margin="4" Spacing="2" MaxWidth="400">
                  <TextBlock Name="AboutTitle" Text="{x:Static vm:MainViewModel.AboutTitle}" FontSize="{StaticResource FontSizeMd}" FontWeight="SemiBold"/>
                  <TextBlock Text="{x:Static vm:MainViewModel.AboutLine}" Classes="dim" FontSize="{StaticResource FontSizeSm}" TextWrapping="Wrap"/>
                </StackPanel>
              </Flyout>
            </FlyoutBase.AttachedFlyout>
            <StackPanel Name="SidebarIdentity" Orientation="Horizontal" Spacing="8">
              <!-- The mark: the panther, from the same master as the window's icon (tools/make-icon.py). -->
              <Image Name="SidebarMark" Source="/Assets/apex-logo.png" Width="24" Height="24"
                     RenderOptions.BitmapInterpolationMode="HighQuality"/>
              <TextBlock Name="SidebarTitle" Text="Apex" FontSize="{StaticResource FontSizeBase}" FontWeight="SemiBold" VerticalAlignment="Center"/>
            </StackPanel>
          </Button>
          <!-- What's new: the running version's release notes (read from its GitHub release), under the mark. -->
          <Popup DockPanel.Dock="Left" PlacementTarget="{Binding #AppMenuButton}" Placement="BottomEdgeAlignedLeft" VerticalOffset="4"
                 IsLightDismissEnabled="True" IsOpen="{Binding IsWhatsNewOpen, Mode=TwoWay}">
            <Border Name="WhatsNewPanel" Background="{DynamicResource BgCardBrush}" BorderBrush="{DynamicResource LineBrush}" BorderThickness="1"
                    CornerRadius="{StaticResource RadiusOverlay}" BoxShadow="{DynamicResource ShadowLayer}" Padding="14" Width="420">
              <DockPanel>
                <TextBlock DockPanel.Dock="Top" Text="{x:Static vm:MainViewModel.WhatsNewTitle}" FontSize="{StaticResource FontSizeMd}" FontWeight="SemiBold"/>
                <Button DockPanel.Dock="Bottom" Classes="link teal" Content="All release notes on GitHub" HorizontalAlignment="Left" Margin="0,10,0,0"
                        Command="{Binding OpenWhatsNewReleaseCommand}" IsVisible="{Binding HasWhatsNewUrl}"/>
                <TextBlock DockPanel.Dock="Top" Classes="dim" FontSize="{StaticResource FontSizeSm}" TextWrapping="Wrap" Margin="0,8,0,0"
                           Text="{Binding WhatsNewMessage}" IsVisible="{Binding HasWhatsNewMessage}"/>
                <ScrollViewer MaxHeight="380" Margin="0,4,0,0" VerticalScrollBarVisibility="Auto">
                  <ItemsControl ItemsSource="{Binding WhatsNewBlocks}">
                    <ItemsControl.ItemTemplate>
                      <DataTemplate x:DataType="svc:MdBlock">
                        <Panel>
                          <controls:MarkdownText Markdown="{Binding Text}" IsVisible="{Binding IsHeading}" FontWeight="SemiBold" TextWrapping="Wrap"
                                                 FontSize="{StaticResource FontSizeBase}" Margin="0,12,0,2"/>
                          <controls:MarkdownText Markdown="{Binding Text}" IsVisible="{Binding IsParagraph}" Classes="dim" TextWrapping="Wrap"
                                                 FontSize="{StaticResource FontSizeSm}" Margin="0,6,0,0"/>
                          <DockPanel IsVisible="{Binding IsBullet}" Margin="0,6,0,0">
                            <TextBlock DockPanel.Dock="Left" Text="•" Classes="dim" Width="14" FontSize="{StaticResource FontSizeSm}"/>
                            <controls:MarkdownText Markdown="{Binding Text}" TextWrapping="Wrap" FontSize="{StaticResource FontSizeSm}"/>
                          </DockPanel>
                        </Panel>
                      </DataTemplate>
                    </ItemsControl.ItemTemplate>
                  </ItemsControl>
                </ScrollViewer>
              </DockPanel>
            </Border>
          </Popup>
          <StackPanel DockPanel.Dock="Right" Name="SidebarActions" Orientation="Horizontal" Spacing="4" VerticalAlignment="Center">
            <Button Name="UndoButton" Classes="icon" Content="↶" c:Cmd.Id="edit.undo" IsEnabled="{Binding CanUndoActive}" IsVisible="{Binding !IsInstallMissing}"/>
            <Button Name="RedoButton" Classes="icon" Content="↷" c:Cmd.Id="edit.redo" IsEnabled="{Binding CanRedoActive}" IsVisible="{Binding !IsInstallMissing}"/>
            <Button Classes="icon" Content="+" AutomationProperties.Name="New asset or GDT" ToolTip.Tip="New asset or GDT"
                    IsVisible="{Binding !IsInstallMissing}">
              <Button.Flyout>
                <MenuFlyout Placement="BottomEdgeAlignedLeft">
                  <MenuItem c:Cmd.Id="asset.new"/>
                  <MenuItem c:Cmd.Id="gdt.new"/>
                </MenuFlyout>
              </Button.Flyout>
            </Button>
            <Button Name="LayoutButton" Classes="icon" Content="layout" ToolTip.Tip="Panes and the preview layout"
                    AutomationProperties.Name="Layout" IsVisible="{Binding !IsInstallMissing}">
              <Button.Flyout>
                <MenuFlyout Placement="BottomEdgeAlignedLeft">
                  <MenuItem c:Cmd.Id="view.maximizePreview"/>
                  <Separator/>
                  <MenuItem c:Cmd.Id="view.explorer"/>
                  <MenuItem c:Cmd.Id="view.inspector"/>
                  <MenuItem c:Cmd.Id="view.previewWindow"/>
                </MenuFlyout>
              </Button.Flyout>
            </Button>
          </StackPanel>
        </DockPanel>

        <!-- Foot: what just happened, and that the assets are samples when they are. -->
        <StackPanel DockPanel.Dock="Bottom" Name="SidebarFoot" Margin="14,6,10,10" Spacing="2">
          <Button Classes="link danger" HorizontalAlignment="Left" IsVisible="{Binding !!ProblemTotal}" c:Cmd.Id="explorer.showProblems"
                  AutomationProperties.Name="{Binding ProblemTotalText}"
                  ToolTip.Tip="{c:Tip explorer.showProblems, Detail='Validation problems in loaded GDTs'}">
            <TextBlock FontSize="{StaticResource FontSizeSm}" Text="{Binding ProblemTotalText}"/>
          </Button>
          <TextBlock Name="MockDataText" Text="Mock data" Classes="faint" FontSize="{StaticResource FontSizeSm}"
                     IsVisible="{Binding IsMockData}" ToolTip.Tip="Generated sample assets, not a Black Ops III install"/>
          <TextBlock Text="{Binding Status}" Classes="faint" FontSize="{StaticResource FontSizeSm}"
                     TextWrapping="Wrap" MaxLines="2" TextTrimming="CharacterEllipsis"
                     AutomationProperties.LiveSetting="Polite"
                     AutomationProperties.Name="{Binding Status}"/>
        </StackPanel>

        <Panel>
          <Border Name="ExplorerLayer" Classes="flat" Margin="8,0,2,0" IsEnabled="{Binding !IsInstallMissing}">
            <views:AssetBrowserView Name="Browser"/>
          </Border>
          <!-- Collapsed Explorer: the sidebar narrows to its verbs; the strip below them brings it back (or Ctrl+B). -->
          <Button Name="ExplorerStrip" Classes="edgestrip" c:Cmd.Id="view.explorer" IsVisible="False"/>
        </Panel>
      </DockPanel>
      <GridSplitter Grid.Column="1" Name="ExplorerSplitter" Classes="gutter" IsEnabled="{Binding !IsInstallMissing}" ResizeDirection="Columns"/>

      <!-- ── The card ── -->
      <Border Grid.Column="2" Name="Card" Classes="card" Margin="0,8,8,8">
        <DockPanel>
          <!-- Top row: open tabs · Go to · the session · window buttons. Its empty part drags the window. -->
          <Border DockPanel.Dock="Top" BorderBrush="{DynamicResource LineBrush}" BorderThickness="0,0,0,1">
            <Grid Name="TopBar" Height="44" ColumnDefinitions="*,Auto,Auto,Auto,Auto" Background="Transparent"
                  PointerPressed="TopBar_PointerPressed">
              <Grid ColumnDefinitions="*,Auto" Margin="8,0,0,0">
                <ListBox Name="TabList" Classes="doctabs" ItemsSource="{Binding OpenTabs}" SelectedItem="{Binding ActiveTab}"
                         ClipToBounds="True" VerticalAlignment="Center" HorizontalAlignment="Left">
                  <ListBox.Styles>
                    <Style Selector="ListBoxItem" x:DataType="vm:AssetEditorViewModel">
                      <Setter Property="AutomationProperties.Name" Value="{Binding Name}"/>
                    </Style>
                  </ListBox.Styles>
                  <ListBox.ItemsPanel>
                    <ItemsPanelTemplate>
                      <controls:TabStripPanel/>
                    </ItemsPanelTemplate>
                  </ListBox.ItemsPanel>
                  <ListBox.ItemTemplate>
                    <DataTemplate x:DataType="vm:AssetEditorViewModel">
                      <!-- Only the active tab keeps room for its ✕; another tab shows it over its end while the pointer is
                           on it (Styles/Shell.axaml), so inactive tabs are as narrow as their names and more of them fit.
                           Spaced by margins, not Spacing, so that ✕ can overlap the content before it. -->
                      <StackPanel Orientation="Horizontal" Background="Transparent"
                                  ToolTip.Tip="{Binding Name}" PointerReleased="Tab_PointerReleased">
                        <StackPanel.ContextMenu>
                          <ContextMenu>
                            <!-- These act on the tab right-clicked, not the active one: their own commands, the catalog's names. -->
                            <MenuItem Command="{Binding CloseCommand}" c:Cmd.Id="tab.close"/>
                            <MenuItem Command="{Binding Owner.CloseOtherTabsCommand}" CommandParameter="{Binding}" c:Cmd.Id="tab.closeOthers"/>
                            <Separator/>
                            <MenuItem Command="{Binding Owner.RevealTabInTreeCommand}" CommandParameter="{Binding}" c:Cmd.Id="asset.reveal"/>
                          </ContextMenu>
                        </StackPanel.ContextMenu>
                        <controls:GlyphIcon Glyph="{Binding Glyph}" Foreground="{Binding TypeBrush}" Size="13" VerticalAlignment="Center"/>
                        <!-- Capped so a dozen tabs still fit; the full name is the tab's tooltip. -->
                        <TextBlock Text="{Binding Name, Converter={x:Static views:MiddleTrim.Tab}}" FontSize="{StaticResource FontSizeSm}"
                                   VerticalAlignment="Center" MaxWidth="180" TextTrimming="CharacterEllipsis" Margin="7,0,0,0"
                                   Classes.previewtab="{Binding IsPreview}" Classes.stock="{Binding IsStock}"/>
                        <!-- Same mark as the Explorer's rows: this asset has edits in this session. -->
                        <Ellipse Width="5" Height="5" Fill="{DynamicResource MarkBrush}" VerticalAlignment="Center" Margin="7,0,0,0"
                                 IsVisible="{Binding !!Changes.Count}" ToolTip.Tip="Changed this session"/>
                        <controls:GlyphIcon Glyph="warning" Size="11" Foreground="{DynamicResource DangerBrush}" VerticalAlignment="Center" Margin="7,0,0,0"
                                            IsVisible="{Binding !!ProblemCount}" ToolTip.Tip="This asset has validation problems"/>
                        <Button Classes="tabclose" Content="✕" Command="{Binding CloseCommand}"
                                AutomationProperties.Name="{c:Name tab.close}" ToolTip.Tip="{c:Tip tab.close}"/>
                      </StackPanel>
                    </DataTemplate>
                  </ListBox.ItemTemplate>
                </ListBox>
                <Button Grid.Column="1" Name="TabOverflowButton" Classes="menu" Margin="4,0,6,0" IsVisible="False"
                        ToolTip.Tip="{c:Tip tab.all, Detail='In strip order'}" Click="TabOverflow_Click">
                  <StackPanel Orientation="Horizontal" Spacing="4">
                    <TextBlock Name="TabOverflowText" FontSize="{StaticResource FontSizeSm}" Classes="dim"/>
                    <controls:GlyphIcon Glyph="chevron-down" Size="12" VerticalAlignment="Center"/>
                  </StackPanel>
                </Button>
              </Grid>

              <!-- The command box is a button: it opens Quick Open, where > runs commands and @ jumps to a property. It says so
                   in the short form of the sentence every description of the palette uses (CommandCatalog.PaletteSentence is its tooltip). -->
              <Button Grid.Column="1" Name="CommandBox" Classes="commandbox" c:Cmd.Id="go.asset" Margin="12,0,8,0" IsVisible="{Binding !IsInstallMissing}"
                      AutomationProperties.Name="{x:Static c:CommandCatalog.PaletteSentence}"
                      ToolTip.Tip="{x:Static c:CommandCatalog.PaletteSentence}">
                <DockPanel>
                  <controls:GlyphIcon DockPanel.Dock="Left" Glyph="search" Size="14" Foreground="{DynamicResource TextFaintBrush}"
                                      VerticalAlignment="Center" Margin="0,0,8,0"/>
                  <TextBlock DockPanel.Dock="Right" Name="QuickOpenKey" Text="{c:Gesture go.asset}" Classes="faint"
                             FontSize="{StaticResource FontSizeXs}" VerticalAlignment="Center"/>
                  <TextBlock Name="CommandBoxText" Classes="faint" FontSize="{StaticResource FontSizeBase}" VerticalAlignment="Center"
                             Text="{x:Static c:CommandCatalog.PaletteBoxText}" TextTrimming="CharacterEllipsis"/>
                </DockPanel>
              </Button>

              <!-- Updates: shown only while there is an update for the user (downloading, ready, installing on close,
                   installed, or failed to download or install). Checking and its outcome live in the app menu's Updates. -->
              <Button Grid.Column="2" Name="UpdateButton" Classes="menu" Margin="0,0,8,0" IsVisible="{Binding Updates.IsShown}"
                      AutomationProperties.Name="{Binding Updates.ChipText}" ToolTip.Tip="{Binding Updates.Title}">
                <StackPanel Orientation="Horizontal" Spacing="6">
                  <controls:GlyphIcon Classes="updateglyph" Classes.pending="{Binding Updates.IsPending}" Glyph="arrow-down" Size="13" VerticalAlignment="Center" IsVisible="{Binding Updates.ShowsArrow}"/>
                  <controls:GlyphIcon Classes="updateglyph" Glyph="warning" Size="13" VerticalAlignment="Center" IsVisible="{Binding Updates.IsFailed}"/>
                  <TextBlock Text="{Binding Updates.ChipText}" FontSize="{StaticResource FontSizeSm}" VerticalAlignment="Center"/>
                </StackPanel>
                <Button.Flyout>
                  <Flyout Placement="BottomEdgeAlignedRight" Closed="UpdateFlyout_Closed">
                    <views:UpdatePanel DataContext="{Binding Updates}"/>
                  </Flyout>
                </Button.Flyout>
              </Button>

              <!-- The session: how many changes aren't in the GDTs yet, and Save. The count reviews them; the tooltip says the rest. -->
              <Border Grid.Column="3" Name="SessionChip" Classes="sessionpill" Margin="0,0,4,0" IsVisible="{Binding !IsInstallMissing}">
                <StackPanel Orientation="Horizontal" Spacing="2">
                  <Button Name="SessionCountButton" Classes="menu" Command="{Binding ReviewChangesCommand}" IsEnabled="{Binding HasSessionChanges}" Padding="7,2"
                          ToolTip.Tip="{Binding SessionChipTip}" AutomationProperties.Name="{Binding SessionStateText}">
                    <StackPanel Orientation="Horizontal" Spacing="8">
                      <Ellipse Width="6" Height="6" VerticalAlignment="Center"
                               Fill="{DynamicResource MarkBrush}" IsVisible="{Binding !!SessionEditCount}"/>
                      <Ellipse Width="6" Height="6" VerticalAlignment="Center"
                               Fill="{DynamicResource TextFaintBrush}" IsVisible="{Binding !SessionEditCount}"/>
                      <TextBlock FontSize="{StaticResource FontSizeBase}" Foreground="{DynamicResource TextSoftBrush}"
                                 Text="{Binding SessionPillText}"/>
                    </StackPanel>
                  </Button>
                  <Button Name="ChipSaveButton" Classes="accent" c:Cmd.Id="file.saveAll" IsVisible="{Binding HasSessionChanges}">
                    <TextBlock Text="Save"/>
                  </Button>
                </StackPanel>
              </Border>

              <StackPanel Grid.Column="4" Name="CaptionButtons" Orientation="Horizontal" IsVisible="False" Margin="4,0,2,0" VerticalAlignment="Center">
                <Button Classes="captionbtn" Content="─" Click="Minimize_Click" ToolTip.Tip="Minimize" AutomationProperties.Name="Minimize"/>
                <Button Classes="captionbtn" Content="▢" Click="Maximize_Click" ToolTip.Tip="Maximize" AutomationProperties.Name="Maximize"/>
                <Button Classes="captionbtn close" Content="✕" Click="CloseButton_Click" ToolTip.Tip="Close" AutomationProperties.Name="Close"/>
              </StackPanel>
            </Grid>
          </Border>

          <!-- Body: the editor | Preview over Inspector, split by hairlines that are also the splitters. -->
          <Grid Name="CardBody">
            <Grid.ColumnDefinitions>
              <ColumnDefinition Width="*" MinWidth="420"/>
              <ColumnDefinition Width="8"/>
              <ColumnDefinition Width="360" MinWidth="0"/>
            </Grid.ColumnDefinitions>

            <!-- Editor: the active asset, or the start page. -->
            <Border Grid.Column="0" Name="EditorLayer" Classes="flat" IsEnabled="{Binding !IsInstallMissing}">
              <Panel>
                <ContentControl Content="{Binding ActiveTab}" IsVisible="{Binding HasActiveTab}">
                  <ContentControl.ContentTemplate>
                    <DataTemplate x:DataType="vm:AssetEditorViewModel">
                      <views:AssetEditorView/>
                    </DataTemplate>
                  </ContentControl.ContentTemplate>
                </ContentControl>
                <!-- Nothing open: the editor becomes a start page and the Inspector steps aside. The top row's command box
                     is right above, so the page doesn't repeat it: it is what was open last, what isn't saved, and the keys.
                     (Pinned assets are the Explorer's own list, at its top.) -->
                <ScrollViewer IsVisible="{Binding HasNoActiveTab}">
                  <StackPanel Name="StartPage" MaxWidth="760" Margin="48,96,48,40" Spacing="30">
                    <StackPanel Spacing="2">
                      <TextBlock Text="Recent" FontSize="{StaticResource FontSizeMd}" FontWeight="SemiBold" Margin="0,0,0,10"/>
                      <TextBlock Classes="faint" FontSize="{StaticResource FontSizeSm}" IsVisible="{Binding !HasRecent}"
                                 Text="Assets you open appear here."/>
                      <ItemsControl Name="RecentList" ItemsSource="{Binding RecentItems}">
                        <ItemsControl.ItemTemplate>
                          <DataTemplate x:DataType="vm:AssetLinkViewModel">
                            <Button Classes="linkrow small" Command="{Binding OpenCommand}" Height="28" ClipToBounds="True"
                                    ToolTip.Tip="{Binding Tip}" AutomationProperties.Name="{Binding Name}">
                              <!-- The name measures first and is never cut for its GDT; the GDT takes what is left. -->
                              <Grid ColumnDefinitions="20,Auto,*">
                                <TextBlock Text="{Binding Glyph}" Foreground="{Binding GlyphBrush}" FontSize="{StaticResource FontSizeSm}" VerticalAlignment="Center"/>
                                <TextBlock Grid.Column="1" Classes="mono" FontSize="{StaticResource FontSizeSm}" Text="{Binding Name}" VerticalAlignment="Center"/>
                                <TextBlock Grid.Column="2" Classes="faint" FontSize="{StaticResource FontSizeXs}" Text="{Binding Detail}" VerticalAlignment="Center"
                                           TextTrimming="CharacterEllipsis" Margin="14,0,0,0"/>
                              </Grid>
                            </Button>
                          </DataTemplate>
                        </ItemsControl.ItemTemplate>
                      </ItemsControl>
                    </StackPanel>

                    <Border Background="{DynamicResource BgFieldBrush}" CornerRadius="{StaticResource RadiusLg}" Padding="16,14" IsVisible="{Binding HasSessionChanges}">
                      <DockPanel>
                        <Ellipse DockPanel.Dock="Left" Width="6" Height="6" Fill="{DynamicResource MarkBrush}" VerticalAlignment="Center" Margin="0,0,14,0"/>
                        <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
                          <Button Name="DiscardSessionButton" Classes="link dim" Content="{c:Name session.discardAll}" c:Cmd.Id="session.discardAll"/>
                          <Button Classes="line" Content="{c:Name explorer.showChanged}" c:Cmd.Id="explorer.showChanged"/>
                          <Button Name="StartSaveButton" Classes="accent" c:Cmd.Id="file.saveAll">
                            <TextBlock Text="{c:Name file.saveAll}"/>
                          </Button>
                        </StackPanel>
                        <StackPanel Spacing="2" VerticalAlignment="Center">
                          <TextBlock FontSize="{StaticResource FontSizeBase}" Text="{Binding SessionSummaryText}"/>
                          <TextBlock Classes="dim" FontSize="{StaticResource FontSizeSm}" Text="{Binding SessionKeptText}"/>
                        </StackPanel>
                      </DockPanel>
                    </Border>

                    <TextBlock Name="StartShortcuts" Classes="faint" FontSize="{StaticResource FontSizeSm}" TextWrapping="Wrap"
                               Text="{c:Hints 'go.asset go.commands go.recent asset.new file.saveAll'}"/>
                  </StackPanel>
                </ScrollViewer>
              </Panel>
            </Border>

            <GridSplitter Grid.Column="1" Name="RightSplitter" Classes="hairline col" IsEnabled="{Binding !IsInstallMissing}" ResizeDirection="Columns"/>

            <!-- Right column: Preview over Inspector; the hairline between them is their splitter. -->
            <Grid Grid.Column="2" Name="RightStack" IsEnabled="{Binding !IsInstallMissing}">
              <Grid.RowDefinitions>
                <RowDefinition Height="236"/>
                <RowDefinition Height="8"/>
                <RowDefinition Height="*"/>
              </Grid.RowDefinitions>
              <Border Grid.Row="0" Name="PreviewLayer" Classes="flat">
                <views:PreviewDockView Name="DockedPreview"/>
              </Border>
              <GridSplitter Grid.Row="1" Name="PreviewSplitter" Classes="hairline row" IsEnabled="{Binding !IsInstallMissing}" ResizeDirection="Rows"/>
              <!-- At the left end of the preview's edge, beside the column's: one drag sizes both together. -->
              <Border Grid.Row="1" Name="PreviewCorner" Classes="cornergrip" IsVisible="{Binding #PreviewSplitter.IsVisible}"
                      IsEnabled="{Binding !IsInstallMissing}"
                      PointerPressed="Corner_PointerPressed" PointerMoved="Corner_PointerMoved" PointerReleased="Corner_PointerReleased" AutomationProperties.Name="Resize the preview"
                      ToolTip.Tip="Drag to resize the preview's width and height together; double-click for 16:9"/>
              <Border Grid.Row="2" Name="InspectorLayer" Classes="flat">
                <views:InspectorView/>
              </Border>
              <!-- An xanim's short properties panel: its preview is in the editor, its notetracks in the dock under it. -->
              <Border Grid.RowSpan="3" Name="PropertiesLayer" Classes="flat solid" IsVisible="False">
                <views:AnimPropertiesView Name="AnimProperties" DataContext="{Binding AnimTab}"/>
              </Border>
            </Grid>

            <!-- Warm the asset-editor input controls at startup: their control templates and text layout
                 JIT on first realization, which would otherwise be paid on the first weapon open.
                 Invisible and non-interactive; costs a few ms once. -->
            <Canvas Opacity="0" IsHitTestVisible="False" Width="0" Height="0" ClipToBounds="True" KeyboardNavigation.TabNavigation="None">
              <StackPanel>
                <controls:ScrubNumberBox Width="130"/>
                <ToggleButton Classes="miniswitch"/>
                <ComboBox Classes="pfield"/>
                <TextBox Classes="pfield" Width="290" Text="warmup"/>
              </StackPanel>
            </Canvas>

            <!-- Full-card overlays: table (spreadsheet) mode and compare mode. -->
            <Border Grid.ColumnSpan="3" Classes="flat solid" IsVisible="{Binding IsTableOpen}">
              <views:TableView DataContext="{Binding Table}"/>
            </Border>
            <Border Grid.ColumnSpan="3" Classes="flat solid" IsVisible="{Binding IsStockSoundsOpen}">
              <views:StockSoundsView DataContext="{Binding StockSounds}"/>
            </Border>
            <Border Grid.ColumnSpan="3" Classes="flat solid" IsVisible="{Binding IsCompareOpen}">
              <views:CompareView DataContext="{Binding Compare}"/>
            </Border>

            <!-- ── Banners ─────────────────────────────────────────────────
                 Anything the user must notice or act on, one banner per problem, newest on top. They float at the foot of
                 the editor: never over the tabs or the editor's header (its name, Compare, ⋯), which are what you reach for
                 to deal with them, and never in a row of their own that would shove every pane under the cursor. Errors
                 stay until dismissed; notices go by themselves (not while the pointer rests on one). -->
            <ItemsControl Grid.Column="0" Name="AlertHost" ZIndex="10" VerticalAlignment="Bottom" HorizontalAlignment="Center"
                          MaxWidth="760" Margin="16,0,16,16" ItemsSource="{Binding Alerts}" IsVisible="{Binding IsAlertOpen}">
              <ItemsControl.ItemsPanel>
                <ItemsPanelTemplate>
                  <StackPanel Spacing="6"/>
                </ItemsPanelTemplate>
              </ItemsControl.ItemsPanel>
              <ItemsControl.ItemTemplate>
                <DataTemplate x:DataType="vm:AlertItem">
                  <Border Background="{DynamicResource BgCardBrush}" CornerRadius="{StaticResource RadiusOverlay}" BoxShadow="{DynamicResource ShadowDialog}"
                          PointerEntered="Alert_PointerEntered" PointerExited="Alert_PointerExited"
                          GotFocus="Alert_GotFocus" LostFocus="Alert_LostFocus">
                    <Border Classes="alert" Classes.error="{Binding IsError}" CornerRadius="{StaticResource RadiusOverlay}" BorderThickness="1"
                            ToolTip.Tip="{Binding Detail}">
                      <DockPanel>
                        <controls:GlyphIcon DockPanel.Dock="Left" Glyph="warning" Size="14" VerticalAlignment="Center" Margin="0,0,10,0"
                                            Foreground="{DynamicResource DangerTextBrush}" IsVisible="{Binding IsError}"/>
                        <TextBlock DockPanel.Dock="Left" Text="ⓘ" FontSize="{StaticResource FontSizeBase}" VerticalAlignment="Center" Margin="0,0,10,0"
                                   Classes="dim" IsVisible="{Binding !IsError}"/>
                        <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
                          <!-- The label carries asset names, which are lowercase_with_underscores: a bare string Content would
                               have them swallowed as access-key markers ("wpn_ar" → "wpnar"). -->
                          <Button Name="AlertAction" Classes="line" Command="{Binding RunCommand}" IsVisible="{Binding HasAction}">
                            <TextBlock Text="{Binding ActionLabel}" FontSize="{StaticResource FontSizeSm}"/>
                          </Button>
                          <Button Name="AlertDismiss" Classes="icon" Content="✕"
                                  AutomationProperties.Name="Dismiss message" ToolTip.Tip="Dismiss (Esc)"
                                  Command="{Binding DismissCommand}"/>
                        </StackPanel>
                        <!-- Live region: the banner appears without focus moving, so a screen reader would otherwise never
                             announce that the user's action was refused. -->
                        <TextBlock Text="{Binding Text}" FontSize="{StaticResource FontSizeSm}" TextWrapping="Wrap"
                                   VerticalAlignment="Center"
                                   AutomationProperties.LiveSetting="Assertive"
                                   AutomationProperties.Name="{Binding Text}"/>
                      </DockPanel>
                    </Border>
                  </Border>
                </DataTemplate>
              </ItemsControl.ItemTemplate>
            </ItemsControl>

            <!-- No install found: the card asks for the Black Ops III folder (nothing behind it is loaded). -->
            <Border Grid.ColumnSpan="3" Name="InstallMissingLayer" Classes="flat solid" IsVisible="{Binding IsInstallMissing}">
              <StackPanel Width="520" HorizontalAlignment="Center" VerticalAlignment="Top" Spacing="8" Margin="0,150,0,0">
                <TextBlock Text="Black Ops III mod tools not found" FontSize="{StaticResource FontSizeMd}" FontWeight="SemiBold"/>
                <TextBlock Classes="dim" FontSize="{StaticResource FontSizeBase}" TextWrapping="Wrap"
                           Text="Apex looks for the Black Ops III folder that holds deffiles and source_data."/>
                <Button Name="LocateButton" Classes="accent" HorizontalAlignment="Left" Margin="0,10,0,0" Click="Locate_Click"
                        AutomationProperties.Name="Locate…" ToolTip.Tip="Choose the Black Ops III folder">
                  <TextBlock Text="Locate…"/>
                </Button>
                <!-- Two lines held from the start, so nothing moves when a wrong folder is explained. -->
                <TextBlock Name="LocateErrorText" Foreground="{DynamicResource DangerTextBrush}" FontSize="{StaticResource FontSizeSm}"
                           TextWrapping="Wrap" MinHeight="36" Text="{Binding LocateError}" AutomationProperties.LiveSetting="Assertive"/>
              </StackPanel>
            </Border>
          </Grid>
        </DockPanel>
      </Border>
    </Grid>

    <!-- ── Confirmation dialog ─────────────────────────────────────
         Only for what undo can't bring back. The body states the blast radius. -->
    <Border Grid.Row="0" Grid.RowSpan="3" Classes="dialogbackdrop" IsVisible="{Binding IsConfirmOpen}"
            PointerPressed="ConfirmBackdrop_PointerPressed">
      <Border Name="ConfirmCard" Classes="dialogcard" PointerPressed="PaletteCard_PointerPressed" KeyboardNavigation.TabNavigation="Cycle">
        <StackPanel Spacing="12">
          <TextBlock Text="{Binding ConfirmTitle}" FontSize="{StaticResource FontSizeMd}" FontWeight="SemiBold" TextWrapping="Wrap"/>
          <TextBlock Text="{Binding ConfirmBody}" Classes="dim body" FontSize="{StaticResource FontSizeBase}"/>
          <StackPanel Orientation="Horizontal" Spacing="8" HorizontalAlignment="Right">
            <Button Name="ConfirmCancelButton" Classes="outline" Content="{Binding ConfirmCancelLabel}"
                    Command="{Binding CancelConfirmCommand}"/>
            <Button Classes="danger" IsVisible="{Binding ConfirmIsDestructive}"
                    Command="{Binding AcceptConfirmCommand}">
              <TextBlock Text="{Binding ConfirmActionLabel}"/>
            </Button>
            <Button Classes="accent" IsVisible="{Binding !ConfirmIsDestructive}"
                    Command="{Binding AcceptConfirmCommand}">
              <TextBlock Text="{Binding ConfirmActionLabel}"/>
            </Button>
          </StackPanel>
        </StackPanel>
      </Border>
    </Border>

    <!-- ── Save conflict ────────────────────────────────────────────
         Only when a GDT changed on disk since Apex read it. Per asset: keep yours or take the file's.
         Nothing is written until Save; Cancel leaves the session and the files as they are. -->
    <Border Grid.Row="0" Grid.RowSpan="3" Classes="dialogbackdrop" IsVisible="{Binding IsConflictOpen}">
      <Border Name="ConflictCard" Classes="dialogcard" Width="640" KeyboardNavigation.TabNavigation="Cycle">
        <DockPanel>
          <StackPanel DockPanel.Dock="Top" Spacing="8" Margin="0,0,0,12">
            <TextBlock Text="Changed on disk" FontSize="{StaticResource FontSizeMd}" FontWeight="SemiBold"/>
            <TextBlock Text="{Binding ConflictSummary}" Classes="dim body" FontSize="{StaticResource FontSizeBase}" TextWrapping="Wrap"/>
          </StackPanel>
          <StackPanel DockPanel.Dock="Bottom" Orientation="Horizontal" Spacing="8" HorizontalAlignment="Right" Margin="0,12,0,0">
            <Button Name="ConflictCancelButton" Classes="outline" Content="Cancel" Command="{Binding CancelConflictsCommand}"/>
            <Button Name="ConflictSaveButton" Classes="accent" Command="{Binding ResolveConflictsCommand}" IsEnabled="{Binding CanResolveConflicts}">
              <TextBlock Text="Save"/>
            </Button>
          </StackPanel>
          <ScrollViewer MaxHeight="360" IsVisible="{Binding !!ConflictItems.Count}">
            <ItemsControl Name="ConflictList" ItemsSource="{Binding ConflictItems}">
              <ItemsControl.ItemTemplate>
                <DataTemplate x:DataType="vm:SaveConflictItem">
                  <Border BorderBrush="{DynamicResource LineBrush}" BorderThickness="0,1,0,0" Padding="0,10,0,8">
                    <DockPanel>
                      <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" Spacing="4" VerticalAlignment="Top"
                                  Margin="12,0,0,0" IsVisible="{Binding CanChoose}">
                        <ToggleButton Name="KeepMinePill" Classes="pill small" Content="Keep mine" IsChecked="{Binding ChooseMine}"/>
                        <ToggleButton Name="TakeFilePill" Classes="pill small" Content="Take the file's" IsChecked="{Binding ChooseFile}"/>
                      </StackPanel>
                      <StackPanel Spacing="3">
                        <TextBlock FontFamily="{StaticResource MonoFont}" FontSize="{StaticResource FontSizeSm}" TextTrimming="CharacterEllipsis">
                          <Run Text="{Binding Asset}"/><Run Text="   "/><Run Text="{Binding Gdt}" Foreground="{DynamicResource TextFaintBrush}"/>
                        </TextBlock>
                        <TextBlock Classes="dim" FontSize="{StaticResource FontSizeSm}" Text="{Binding What}" TextWrapping="Wrap"/>
                        <ItemsControl ItemsSource="{Binding Lines}">
                          <ItemsControl.ItemTemplate>
                            <DataTemplate x:DataType="x:String">
                              <TextBlock Classes="faint" FontFamily="{StaticResource MonoFont}" FontSize="{StaticResource FontSizeXs}"
                                         Text="{Binding}" TextWrapping="Wrap"/>
                            </DataTemplate>
                          </ItemsControl.ItemTemplate>
                        </ItemsControl>
                      </StackPanel>
                    </DockPanel>
                  </Border>
                </DataTemplate>
              </ItemsControl.ItemTemplate>
            </ItemsControl>
          </ScrollViewer>
        </DockPanel>
      </Border>
    </Border>

    <!-- ── Change weapon class ─────────────────────────────────────
         From → To, what the new class can't hold as it is (a pick per choice it doesn't offer, the keys it has no
         field for), and one button. Undo takes it back, so no warning colour. -->
    <Border Grid.Row="0" Grid.RowSpan="3" Classes="dialogbackdrop" IsVisible="{Binding IsClassOpen}"
            PointerPressed="ClassBackdrop_PointerPressed">
      <Border Name="ClassCard" Classes="dialogcard" Width="600" PointerPressed="PaletteCard_PointerPressed" KeyboardNavigation.TabNavigation="Cycle"
              DataContext="{Binding ClassDialog}" x:DataType="vm:WeaponClassDialogViewModel">
        <DockPanel>
          <StackPanel DockPanel.Dock="Top" Spacing="14">
            <StackPanel Spacing="6">
              <TextBlock FontWeight="SemiBold" FontSize="{StaticResource FontSizeMd}" Text="Change weapon class"/>
              <TextBlock Classes="dim" FontSize="{StaticResource FontSizeBase}" TextWrapping="Wrap" Text="{Binding Intro}"/>
            </StackPanel>
            <Grid ColumnDefinitions="*,32,*" RowDefinitions="Auto,6,Auto">
              <TextBlock Classes="faint" FontSize="{StaticResource FontSizeXs}" Text="From"/>
              <TextBlock Grid.Column="2" Classes="faint" FontSize="{StaticResource FontSizeXs}" Text="To"/>
              <Border Grid.Row="2" Height="30" Padding="10,0" CornerRadius="{StaticResource RadiusMd}"
                      Background="{DynamicResource BgFieldBrush}" BorderBrush="{DynamicResource LineBrush}" BorderThickness="1">
                <TextBlock Classes="dim mono" FontSize="{StaticResource FontSizeBase}" Text="{Binding From}" VerticalAlignment="Center"/>
              </Border>
              <controls:GlyphIcon Grid.Row="2" Grid.Column="1" Glyph="arrow-right" Size="14" HorizontalAlignment="Center" VerticalAlignment="Center"
                                  Foreground="{DynamicResource TextFaintBrush}"/>
              <ComboBox Grid.Row="2" Grid.Column="2" Name="ClassTargetBox" Classes="field" HorizontalAlignment="Stretch" FontFamily="{StaticResource MonoFont}"
                        ItemsSource="{Binding Targets}" SelectedItem="{Binding Target}" AutomationProperties.Name="New class"/>
            </Grid>
            <Border Padding="12,9" CornerRadius="{StaticResource RadiusMd}" Background="{DynamicResource BgFieldBrush}">
              <WrapPanel>
                <TextBlock Classes="dim" FontSize="{StaticResource FontSizeSm}" Text="{Binding CarriedText}" Margin="0,0,16,0"/>
                <TextBlock FontSize="{StaticResource FontSizeSm}" Text="{Binding ChoicesText}" Margin="0,0,16,0"
                           Foreground="{DynamicResource MarkBrush}" IsVisible="{Binding HasChoices}"/>
                <TextBlock Classes="dim" FontSize="{StaticResource FontSizeSm}" Text="{Binding OrphansText}" Margin="0,0,16,0"/>
                <TextBlock Classes="dim" FontSize="{StaticResource FontSizeSm}" Text="{Binding NewFieldsText}"/>
              </WrapPanel>
            </Border>
            <TextBlock Classes="dim" FontSize="{StaticResource FontSizeBase}" Text="Every value carries over as it is."
                       IsVisible="{Binding NothingToSettle}"/>
            <TextBlock FontSize="{StaticResource FontSizeSm}" Foreground="{DynamicResource DangerTextBrush}" TextWrapping="Wrap"
                       Text="{Binding Unavailable}" IsVisible="{Binding !!Unavailable.Length}"/>
          </StackPanel>
          <DockPanel DockPanel.Dock="Bottom" Margin="0,16,0,0">
            <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" Spacing="8">
              <Button Name="ClassCancelButton" Classes="outline" Content="Cancel" Command="{Binding CancelCommand}"/>
              <Button Name="ClassAcceptButton" Classes="accent" Command="{Binding AcceptCommand}" IsEnabled="{Binding !Unavailable.Length}">
                <TextBlock Text="{Binding ActionLabel}"/>
              </Button>
            </StackPanel>
            <TextBlock Classes="faint" FontSize="{StaticResource FontSizeSm}" VerticalAlignment="Center" Text="Ctrl+Z takes it back until you save."/>
          </DockPanel>
          <ScrollViewer MaxHeight="380" Margin="0,14,0,0" IsVisible="{Binding !NothingToSettle}">
            <StackPanel Spacing="16">
              <StackPanel Spacing="8" IsVisible="{Binding HasChoices}">
                <TextBlock FontSize="{StaticResource FontSizeSm}">
                  <Run Text="Needs a new value" FontWeight="SemiBold" FontSize="{StaticResource FontSizeBase}"/><Run Text="   "/><Run Text="{Binding ChoicesNote}" Foreground="{DynamicResource TextFaintBrush}"/>
                </TextBlock>
                <ItemsControl Name="ClassChoiceList" ItemsSource="{Binding Choices}">
                  <ItemsControl.ItemTemplate>
                    <DataTemplate x:DataType="vm:RemapChoiceRow">
                      <Grid ColumnDefinitions="150,*,24,180" Margin="0,0,0,6">
                        <TextBlock VerticalAlignment="Center" TextTrimming="CharacterEllipsis" ToolTip.Tip="{Binding Key}">
                          <Run Text="{Binding Label}"/><Run Text=" "/><Run Text="{Binding Key}" FontSize="{StaticResource FontSizeXs}" Foreground="{DynamicResource TextFaintBrush}"/>
                        </TextBlock>
                        <TextBlock Grid.Column="1" VerticalAlignment="Center" Margin="10,0,0,0" TextTrimming="CharacterEllipsis">
                          <Run Text="{Binding OldValue}" FontFamily="{StaticResource MonoFont}" TextDecorations="Strikethrough" Foreground="{DynamicResource TextDimBrush}"/><Run Text="  "/><Run Text="{Binding HoldersText}" FontSize="{StaticResource FontSizeXs}" Foreground="{DynamicResource TextFaintBrush}"/>
                        </TextBlock>
                        <controls:GlyphIcon Grid.Column="2" Glyph="arrow-right" Size="13" HorizontalAlignment="Center" VerticalAlignment="Center"
                                            Foreground="{DynamicResource TextFaintBrush}"/>
                        <ComboBox Grid.Column="3" Classes="field" HorizontalAlignment="Stretch" FontFamily="{StaticResource MonoFont}"
                                  ItemsSource="{Binding Options}" SelectedItem="{Binding Selected}" AutomationProperties.Name="{Binding AccessibleName}"/>
                      </Grid>
                    </DataTemplate>
                  </ItemsControl.ItemTemplate>
                </ItemsControl>
              </StackPanel>
              <StackPanel Spacing="8" IsVisible="{Binding HasOrphans}">
                <TextBlock FontSize="{StaticResource FontSizeSm}">
                  <Run Text="{Binding OrphansHeading}" FontWeight="SemiBold" FontSize="{StaticResource FontSizeBase}"/><Run Text="   "/><Run Text="{Binding OrphansNote}" Foreground="{DynamicResource TextFaintBrush}"/>
                </TextBlock>
                <Border BorderBrush="{DynamicResource LineBrush}" BorderThickness="1" CornerRadius="{StaticResource RadiusMd}" Padding="10,4"
                        IsVisible="{Binding HasSetOrphans}">
                  <ItemsControl Name="ClassOrphanList" ItemsSource="{Binding Orphans}">
                    <ItemsControl.ItemTemplate>
                      <DataTemplate x:DataType="vm:RemapOrphanRow">
                        <Grid ColumnDefinitions="*,*,Auto" Margin="0,3">
                          <TextBlock Classes="mono" FontSize="{StaticResource FontSizeSm}" Text="{Binding Key}" TextTrimming="CharacterEllipsis"/>
                          <TextBlock Grid.Column="1" Classes="dim mono" FontSize="{StaticResource FontSizeSm}" Text="{Binding Value}" TextTrimming="CharacterEllipsis"
                                     Margin="10,0,0,0" ToolTip.Tip="{Binding Value}"/>
                          <TextBlock Grid.Column="2" Classes="faint" FontSize="{StaticResource FontSizeXs}" Text="{Binding HoldersText}" VerticalAlignment="Center" Margin="10,0,0,0"/>
                        </Grid>
                      </DataTemplate>
                    </ItemsControl.ItemTemplate>
                  </ItemsControl>
                </Border>
                <TextBlock Classes="faint" FontSize="{StaticResource FontSizeSm}" Text="{Binding DefaultOrphansText}" IsVisible="{Binding HasDefaultOrphans}"/>
                <CheckBox Name="ClassKeepOrphans" IsChecked="{Binding KeepOrphans}">
                  <TextBlock>
                    <Run Text="Keep them in the GDT anyway"/><Run Text="  (APE and the linker ignore them)" Foreground="{DynamicResource TextFaintBrush}" FontSize="{StaticResource FontSizeSm}"/>
                  </TextBlock>
                </CheckBox>
              </StackPanel>
            </StackPanel>
          </ScrollViewer>
        </DockPanel>
      </Border>
    </Border>

    <!-- ── Use in map (a stock asset): name it, Dragon carries it ─────────────────────────────────────────────────
         Nothing is copied. The helper says what a build carries; a weapon's zone line is added to the map's zone file
         only after a second, explicit step. ── -->
    <Border Grid.Row="0" Grid.RowSpan="3" Classes="dialogbackdrop" IsVisible="{Binding IsUseOpen}" PointerPressed="UseBackdrop_PointerPressed">
      <Border Name="UseCard" Classes="dialogcard" Width="640" PointerPressed="PaletteCard_PointerPressed"
              KeyboardNavigation.TabNavigation="Cycle" DataContext="{Binding UseDialog}" x:DataType="vm:StockUseViewModel">
        <StackPanel Spacing="12">
          <StackPanel Spacing="4">
            <DockPanel>
              <Button DockPanel.Dock="Right" Name="UseCloseButton" Classes="icon" Content="✕" Command="{Binding CloseCommand}"
                      AutomationProperties.Name="Close" ToolTip.Tip="Close"/>
              <TextBlock FontWeight="SemiBold" FontSize="{StaticResource FontSizeMd}" Text="Use in map" VerticalAlignment="Center"/>
            </DockPanel>
            <TextBlock Name="UseSubtitle" Classes="dim" FontSize="{StaticResource FontSizeBase}" TextTrimming="CharacterEllipsis">
              <Run Text="{Binding AssetName, Mode=OneWay}" FontStyle="Italic" Foreground="{DynamicResource TextSoftBrush}"/><Run Text="  ·  "/><Run Text="{Binding Kind, Mode=OneWay}"/><Run Text="  ·  "/><Run Text="{Binding Subtitle, Mode=OneWay}"/>
            </TextBlock>
          </StackPanel>
          <TextBlock Name="UseIntro" Classes="dim" FontSize="{StaticResource FontSizeBase}" TextWrapping="Wrap" Text="{Binding Intro}"/>
          <StackPanel Spacing="6">
            <TextBlock Classes="dim" FontSize="{StaticResource FontSizeSm}" Text="Map or mod"/>
            <ComboBox Name="UseTargetBox" Classes="field" HorizontalAlignment="Stretch" ItemsSource="{Binding Targets}" SelectedItem="{Binding Target}"
                      AutomationProperties.Name="Map or mod to use it in">
              <ComboBox.ItemTemplate>
                <DataTemplate x:DataType="stock:CloneTarget">
                  <TextBlock Text="{Binding Label}" FontFamily="{StaticResource MonoFont}" FontSize="{StaticResource FontSizeSm}"/>
                </DataTemplate>
              </ComboBox.ItemTemplate>
            </ComboBox>
          </StackPanel>
          <TextBlock Name="UseCarrySummary" Classes="faint" FontSize="{StaticResource FontSizeSm}" TextWrapping="Wrap" Text="{Binding CarrySummary}"/>
          <ItemsControl Name="UseWarnings" ItemsSource="{Binding Warnings}" IsVisible="{Binding HasWarnings}">
            <ItemsControl.ItemTemplate>
              <DataTemplate x:DataType="x:String">
                <TextBlock FontSize="{StaticResource FontSizeSm}" TextWrapping="Wrap" Foreground="{DynamicResource MarkBrush}" Text="{Binding}" Margin="0,0,0,4"/>
              </DataTemplate>
            </ItemsControl.ItemTemplate>
          </ItemsControl>

          <!-- A weapon is named in the zone file: the line, the file, and an explicit confirm before anything is written -->
          <StackPanel Spacing="6" IsVisible="{Binding IsWeapon}">
            <TextBlock Classes="dim" FontSize="{StaticResource FontSizeSm}" Text="Zone line"/>
            <Border Background="{DynamicResource BgFieldBrush}" BorderBrush="{DynamicResource LineBrush}" BorderThickness="1"
                    CornerRadius="{StaticResource RadiusMd}" Padding="12,8">
              <SelectableTextBlock Name="UseZoneLine" Classes="mono" FontSize="{StaticResource FontSizeBase}" Text="{Binding ZoneLine}"/>
            </Border>
            <TextBlock Name="UseZoneNote" Classes="faint" FontSize="{StaticResource FontSizeSm}" TextWrapping="Wrap" Text="{Binding ZoneNote}"
                       IsVisible="{Binding !!ZoneNote.Length}"/>
            <Border Name="UseConfirm" IsVisible="{Binding IsConfirming}" Background="{DynamicResource BgFieldBrush}" BorderBrush="{DynamicResource LineStrongBrush}"
                    BorderThickness="1" CornerRadius="{StaticResource RadiusMd}" Padding="12,10">
              <StackPanel Spacing="8">
                <TextBlock FontSize="{StaticResource FontSizeBase}" TextWrapping="Wrap">
                  <Run Text="Add "/><Run Text="{Binding ZoneLine, Mode=OneWay}" FontFamily="{StaticResource MonoFont}"/><Run Text=" to the end of "/><Run Text="{Binding ZoneFile, Mode=OneWay}" FontFamily="{StaticResource MonoFont}" FontSize="{StaticResource FontSizeSm}"/><Run Text="?"/>
                </TextBlock>
                <StackPanel Orientation="Horizontal" Spacing="8">
                  <Button Name="UseConfirmButton" Classes="accent" Command="{Binding ConfirmAddLineCommand}"><TextBlock Text="Add the line"/></Button>
                  <Button Name="UseConfirmCancelButton" Classes="outline" Command="{Binding CancelAddLineCommand}"><TextBlock Text="Cancel"/></Button>
                </StackPanel>
              </StackPanel>
            </Border>
          </StackPanel>
          <TextBlock FontSize="{StaticResource FontSizeSm}" Foreground="{DynamicResource DangerTextBrush}" TextWrapping="Wrap" Text="{Binding Error}" IsVisible="{Binding !!Error.Length}"/>

          <DockPanel>
            <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" Spacing="8">
              <Button Name="UseAddLineButton" Classes="accent" Command="{Binding AddLineCommand}" IsEnabled="{Binding CanAddLine}" IsVisible="{Binding ShowAddLine}">
                <TextBlock Text="Add to zone file…"/>
              </Button>
              <Button Name="UseCopyNameButton" Classes="accent" Command="{Binding CopyNameCommand}" IsVisible="{Binding !IsWeapon}"><TextBlock Text="Copy name"/></Button>
              <Button Name="UseCopyNameSecondary" Classes="outline" Command="{Binding CopyNameCommand}" IsVisible="{Binding IsWeapon}"><TextBlock Text="Copy name"/></Button>
            </StackPanel>
            <Button Name="UseCreateCopyButton" Classes="link teal" HorizontalAlignment="Left" VerticalAlignment="Center" Command="{Binding CreateCopyInsteadCommand}"
                    AutomationProperties.Name="Create local copy instead">
              <TextBlock Text="Create local copy instead…" FontSize="{StaticResource FontSizeSm}"/>
            </Button>
          </DockPanel>
        </StackPanel>
      </Border>
    </Border>

    <!-- ── Components: what this install has, from the component registry ───────────────────────────────────────── -->
    <Border Grid.Row="0" Grid.RowSpan="3" Classes="dialogbackdrop" IsVisible="{Binding IsComponentsOpen}" PointerPressed="ComponentsBackdrop_PointerPressed">
      <Border Name="ComponentsCard" Classes="dialogcard" Width="800" Padding="0" PointerPressed="PaletteCard_PointerPressed"
              KeyboardNavigation.TabNavigation="Cycle" DataContext="{Binding Components}" x:DataType="vm:ComponentsViewModel">
        <DockPanel>
          <Border DockPanel.Dock="Top" BorderBrush="{DynamicResource LineBrush}" BorderThickness="0,0,0,1" Padding="22,18,16,14">
            <StackPanel Spacing="4">
              <DockPanel>
                <Button DockPanel.Dock="Right" Name="ComponentsCloseButton" Classes="icon" Content="✕" Command="{Binding CloseCommand}"
                        AutomationProperties.Name="Close" ToolTip.Tip="Close"/>
                <Button DockPanel.Dock="Right" Name="ComponentsRefreshButton" Classes="link teal" Command="{Binding RefreshCommand}" IsEnabled="{Binding !IsChecking}"
                        Margin="0,0,8,0" AutomationProperties.Name="Check again">
                  <TextBlock Text="Check again" FontSize="{StaticResource FontSizeSm}"/>
                </Button>
                <StackPanel Orientation="Horizontal" Spacing="10" VerticalAlignment="Center">
                  <TextBlock FontWeight="SemiBold" FontSize="{StaticResource FontSizeMd}" Text="Components" VerticalAlignment="Center"/>
                  <Border Name="ComponentsPill" BorderBrush="{DynamicResource AccentDimBrush}" BorderThickness="1" CornerRadius="999" Padding="8,1"
                          VerticalAlignment="Center">
                    <TextBlock Name="ComponentsPillText" FontSize="{StaticResource FontSizeSm}" Text="{Binding Pill}"
                               Foreground="{DynamicResource AccentTextBrush}"/>
                  </Border>
                </StackPanel>
              </DockPanel>
              <TextBlock Classes="dim" FontSize="{StaticResource FontSizeBase}" TextTrimming="CharacterEllipsis">
                <Run Text="For "/><Run Text="{Binding Install, Mode=OneWay}" FontFamily="{StaticResource MonoFont}" FontSize="{StaticResource FontSizeSm}"/>
              </TextBlock>
            </StackPanel>
          </Border>
          <Border DockPanel.Dock="Bottom" BorderBrush="{DynamicResource LineBrush}" BorderThickness="0,1,0,0" Padding="22,12">
            <TextBlock Classes="faint" FontSize="{StaticResource FontSizeSm}" TextWrapping="Wrap"
                       Text="Every Mod Tools app shows this same list. Stock Library and Dragon are picked up automatically when they're installed."/>
          </Border>
          <ScrollViewer VerticalScrollBarVisibility="Auto" Padding="22,6">
            <ItemsControl Name="ComponentRows" ItemsSource="{Binding Rows}">
              <ItemsControl.ItemTemplate>
                <DataTemplate x:DataType="vm:ComponentRow">
                  <Border BorderBrush="{DynamicResource LineBrush}" BorderThickness="0,0,0,1" Padding="0,12">
                    <Grid ColumnDefinitions="22,200,*,150" ColumnSpacing="12">
                      <Panel VerticalAlignment="Top" Margin="0,1,0,0">
                        <TextBlock Text="✓" Foreground="{DynamicResource AccentBrush}" IsVisible="{Binding IsOk}" FontWeight="Bold"/>
                        <TextBlock Text="▲" Foreground="{DynamicResource MarkBrush}" IsVisible="{Binding IsWarn}"/>
                        <TextBlock Text="○" Foreground="{DynamicResource TextFaintBrush}" IsVisible="{Binding IsOff}"/>
                      </Panel>
                      <StackPanel Grid.Column="1" Spacing="2">
                        <TextBlock FontWeight="Medium" Text="{Binding Name}"/>
                        <TextBlock Classes="faint mono" FontSize="{StaticResource FontSizeSm}" Text="{Binding Status}" TextWrapping="Wrap"/>
                      </StackPanel>
                      <TextBlock Grid.Column="2" Foreground="{DynamicResource TextSoftBrush}" TextWrapping="Wrap" Text="{Binding Detail}"/>
                      <StackPanel Grid.Column="3" HorizontalAlignment="Right" VerticalAlignment="Top">
                        <Button Classes="accent" Command="{Binding Command}" IsVisible="{Binding IsPrimary}"><TextBlock Text="{Binding Action}"/></Button>
                        <Button Classes="link teal" Command="{Binding Command}" IsVisible="{Binding IsLink}"><TextBlock Text="{Binding Action}"/></Button>
                      </StackPanel>
                    </Grid>
                  </Border>
                </DataTemplate>
              </ItemsControl.ItemTemplate>
            </ItemsControl>
          </ScrollViewer>
        </DockPanel>
      </Border>
    </Border>

    <!-- ── Create local copy (a stock asset): where it goes, what it is called, what comes with it ─────────────────
         The helper reads the game's own files; this only asks and shows. Copy, editable · Use shipped · Rebuilt by the
         linker are the helper's classes for each asset the copy touches. ── -->
    <Border Grid.Row="0" Grid.RowSpan="3" Classes="dialogbackdrop" IsVisible="{Binding IsCloneOpen}" PointerPressed="CloneBackdrop_PointerPressed">
      <Border Name="CloneCard" Classes="dialogcard" Width="960" Height="740" Padding="0" PointerPressed="PaletteCard_PointerPressed"
              KeyboardNavigation.TabNavigation="Cycle" DataContext="{Binding CloneDialog}" x:DataType="vm:StockCloneViewModel">
        <DockPanel>
          <!-- Title: the asset (italic, it is stock), its type, where it ships -->
          <Border DockPanel.Dock="Top" BorderBrush="{DynamicResource LineBrush}" BorderThickness="0,0,0,1" Padding="24,18,20,14">
            <StackPanel Spacing="4">
              <DockPanel>
                <Button DockPanel.Dock="Right" Name="CloneCloseButton" Classes="icon" Content="✕" Command="{Binding CloseCommand}"
                        AutomationProperties.Name="Close" ToolTip.Tip="Close"/>
                <TextBlock FontWeight="SemiBold" FontSize="{StaticResource FontSizeMd}" Text="Create local copy" VerticalAlignment="Center"/>
              </DockPanel>
              <TextBlock Name="CloneSubtitle" Classes="dim" FontSize="{StaticResource FontSizeBase}" TextTrimming="CharacterEllipsis">
                <Run Text="{Binding AssetName, Mode=OneWay}" FontStyle="Italic" Foreground="{DynamicResource TextSoftBrush}"/><Run Text="  ·  "/><Run Text="{Binding Kind, Mode=OneWay}"/><Run Text="  ·  "/><Run Text="{Binding Subtitle, Mode=OneWay}"/>
              </TextBlock>
              <!-- The way with no copy: on when Dragon carries stock assets here, off with the reason and the fix otherwise. -->
              <DockPanel Margin="0,8,0,0" IsVisible="{Binding ShowPlan}">
                <Button DockPanel.Dock="Right" Name="CloneUseDirectlyButton" Classes="outline" Margin="12,0,0,0" Command="{Binding UseDirectlyCommand}"
                        IsEnabled="{Binding UseDirectlyOk}" ToolTip.Tip="{Binding UseDirectlyNote}" ToolTip.ShowOnDisabled="True" AutomationProperties.Name="Use directly">
                  <TextBlock Text="Use directly"/>
                </Button>
                <TextBlock Name="CloneUseDirectlyNote" Classes="faint" FontSize="{StaticResource FontSizeSm}" TextWrapping="Wrap" VerticalAlignment="Center"
                           Text="{Binding UseDirectlyNote}"/>
              </DockPanel>
            </StackPanel>
          </Border>

          <!-- Footer: the summary line, then the buttons (or the progress while it writes) -->
          <Border DockPanel.Dock="Bottom" BorderBrush="{DynamicResource LineBrush}" BorderThickness="0,1,0,0" Padding="24,12">
            <DockPanel>
              <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" Spacing="8" VerticalAlignment="Center" Margin="16,0,0,0">
                <Button Name="CloneUndoButton" Classes="outline" Command="{Binding UndoCommand}" IsVisible="{Binding ShowResult}" IsEnabled="{Binding CanUndo}">
                  <TextBlock Text="Undo"/>
                </Button>
                <Button Name="CloneCancelButton" Classes="outline" Command="{Binding CloseCommand}" IsVisible="{Binding !ShowResult}" IsEnabled="{Binding !IsRunning}">
                  <TextBlock Text="Cancel"/>
                </Button>
                <Button Name="CloneCreateButton" Classes="accent" Command="{Binding CreateCommand}" IsVisible="{Binding !ShowResult}" IsEnabled="{Binding CanCreate}">
                  <TextBlock Text="{Binding CreateLabel}"/>
                </Button>
                <Button Name="CloneDoneButton" Classes="accent" Command="{Binding CloseCommand}" IsVisible="{Binding ShowResult}">
                  <TextBlock Text="Done"/>
                </Button>
              </StackPanel>
              <StackPanel IsVisible="{Binding IsRunning}" VerticalAlignment="Center" Spacing="4">
                <ProgressBar Height="4" Minimum="0" Maximum="1" Value="{Binding ProgressFraction}" IsIndeterminate="{Binding !ProgressKnown}"/>
                <TextBlock Name="CloneProgressText" Classes="dim" FontSize="{StaticResource FontSizeSm}" Text="{Binding ProgressText}" TextTrimming="CharacterEllipsis"/>
              </StackPanel>
              <TextBlock Name="CloneSummary" Classes="dim" FontSize="{StaticResource FontSizeBase}" VerticalAlignment="Center" TextTrimming="CharacterEllipsis"
                         Text="{Binding Summary}" ToolTip.Tip="{Binding Summary}" IsVisible="{Binding IsReady}"/>
              <TextBlock Name="ClonePlanning" Classes="dim" FontSize="{StaticResource FontSizeBase}" VerticalAlignment="Center"
                         Text="{Binding PlanNote}" IsVisible="{Binding IsPlanning}"/>
              <TextBlock Name="CloneFooterError" FontSize="{StaticResource FontSizeSm}" VerticalAlignment="Center" TextWrapping="Wrap" MaxLines="2"
                         Foreground="{DynamicResource DangerTextBrush}" Text="{Binding Error}" IsVisible="{Binding !!Error.Length}"/>
            </DockPanel>
          </Border>

          <!-- After the copy: what was made, the zone lines to add, Undo -->
          <ScrollViewer IsVisible="{Binding ShowResult}" VerticalScrollBarVisibility="Auto">
            <StackPanel Name="CloneResult" Spacing="14" Margin="24,20">
              <StackPanel Spacing="4">
                <TextBlock Name="CloneResultTitle" FontWeight="SemiBold" FontSize="{StaticResource FontSizeMd}" Text="{Binding ResultTitle}"/>
                <TextBlock Classes="dim" FontSize="{StaticResource FontSizeBase}" TextWrapping="Wrap" Text="{Binding ResultDetail}"/>
              </StackPanel>
              <StackPanel Spacing="6" IsVisible="{Binding HasZoneLines}">
                <DockPanel>
                  <Button DockPanel.Dock="Right" Classes="link teal" Command="{Binding CopyZoneLinesCommand}" AutomationProperties.Name="Copy the zone lines">
                    <TextBlock Text="Copy" FontSize="{StaticResource FontSizeSm}"/>
                  </Button>
                  <TextBlock Classes="dim" FontSize="{StaticResource FontSizeSm}" Text="Add these lines to your zone file" VerticalAlignment="Center"/>
                </DockPanel>
                <Border Background="{DynamicResource BgFieldBrush}" BorderBrush="{DynamicResource LineBrush}" BorderThickness="1"
                        CornerRadius="{StaticResource RadiusMd}" Padding="12,10">
                  <SelectableTextBlock Name="CloneZoneLines" Classes="mono" FontSize="{StaticResource FontSizeBase}" Text="{Binding ZoneLines}"/>
                </Border>
              </StackPanel>
              <TextBlock Classes="dim" FontSize="{StaticResource FontSizeSm}" TextWrapping="Wrap" Text="{Binding ResultNotes}" IsVisible="{Binding HasResultNotes}"/>
              <TextBlock Name="CloneAfterText" Classes="faint" FontSize="{StaticResource FontSizeSm}" TextWrapping="Wrap" Text="{Binding AfterText}"/>
            </StackPanel>
          </ScrollViewer>

          <!-- Before the copy: options, then the tree -->
          <DockPanel IsVisible="{Binding ShowPlan}">
            <Grid DockPanel.Dock="Top" ColumnDefinitions="*,24,*" RowDefinitions="Auto,Auto,Auto" Margin="24,14,24,10" RowSpacing="12">
              <StackPanel Spacing="6">
                <TextBlock Classes="dim" FontSize="{StaticResource FontSizeSm}" Text="Copy into"/>
                <ComboBox Name="CloneTargetBox" Classes="field" HorizontalAlignment="Stretch" ItemsSource="{Binding Targets}" SelectedItem="{Binding Target}"
                          IsEnabled="{Binding !IsRunning}" AutomationProperties.Name="Map or mod to copy into">
                  <ComboBox.ItemTemplate>
                    <DataTemplate x:DataType="stock:CloneTarget">
                      <TextBlock Text="{Binding Label}" FontFamily="{StaticResource MonoFont}" FontSize="{StaticResource FontSizeSm}"/>
                    </DataTemplate>
                  </ComboBox.ItemTemplate>
                </ComboBox>
              </StackPanel>
              <StackPanel Grid.Column="2" Spacing="6">
                <TextBlock Classes="dim" FontSize="{StaticResource FontSizeSm}" Text="Add to GDT"/>
                <ComboBox Name="CloneGdtBox" Classes="field" HorizontalAlignment="Stretch" ItemsSource="{Binding Gdts}" SelectedItem="{Binding Gdt}"
                          IsEnabled="{Binding !IsRunning}" AutomationProperties.Name="GDT to add the copy to">
                  <ComboBox.ItemTemplate>
                    <DataTemplate x:DataType="vm:CloneGdtChoice">
                      <TextBlock FontSize="{StaticResource FontSizeSm}" TextTrimming="CharacterEllipsis">
                        <Run Text="{Binding Label, Mode=OneWay}" FontFamily="{StaticResource MonoFont}"/><Run Text="  "/><Run Text="{Binding Detail, Mode=OneWay}" Foreground="{DynamicResource TextFaintBrush}"/>
                      </TextBlock>
                    </DataTemplate>
                  </ComboBox.ItemTemplate>
                </ComboBox>
              </StackPanel>

              <StackPanel Grid.Row="1" Spacing="6">
                <TextBlock Classes="dim" FontSize="{StaticResource FontSizeSm}" Text="Name"/>
                <RadioButton Name="CloneKeepName" GroupName="CloneName" IsChecked="{Binding KeepName}" IsEnabled="{Binding KeepAllowed}">
                  <TextBlock TextTrimming="CharacterEllipsis">
                    <Run Text="Keep "/><Run Text="{Binding AssetName, Mode=OneWay}" FontFamily="{StaticResource MonoFont}" FontSize="{StaticResource FontSizeSm}"/><Run Text="  "/><Run Text="{Binding KeepSuffix, Mode=OneWay}" Foreground="{DynamicResource TextFaintBrush}"/>
                  </TextBlock>
                </RadioButton>
                <RadioButton Name="CloneNewName" GroupName="CloneName" IsChecked="{Binding NewName}">
                  <TextBlock Text="New name, applied to every copied asset" Foreground="{DynamicResource TextSoftBrush}"/>
                </RadioButton>
                <TextBox Name="ClonePrefixBox" Classes="field small" Margin="26,0,0,0" FontFamily="{StaticResource MonoFont}" Text="{Binding Prefix}"
                         IsVisible="{Binding NewName}" PlaceholderText="Prefix, e.g. zm_guns_" AutomationProperties.Name="Name prefix"/>
                <TextBlock Name="CloneNameNote" Classes="faint" FontSize="{StaticResource FontSizeSm}" TextWrapping="Wrap" Margin="26,0,0,0"
                           Text="{Binding NameNote}" IsVisible="{Binding !!NameNote.Length}"/>
              </StackPanel>
              <StackPanel Grid.Row="1" Grid.Column="2" Spacing="6">
                <TextBlock Classes="dim" FontSize="{StaticResource FontSizeSm}" Text="Source files go to" IsVisible="{Binding HasSourceFolders}"/>
                <ItemsControl Name="CloneFolders" ItemsSource="{Binding SourceFolders}">
                  <ItemsControl.ItemTemplate>
                    <DataTemplate x:DataType="x:String">
                      <Border Background="{DynamicResource BgFieldBrush}" BorderBrush="{DynamicResource LineBrush}" BorderThickness="1"
                              CornerRadius="{StaticResource RadiusMd}" Padding="10,6" Margin="0,0,0,4">
                        <TextBlock Classes="mono dim" FontSize="{StaticResource FontSizeSm}" Text="{Binding}" TextTrimming="CharacterEllipsis"/>
                      </Border>
                    </DataTemplate>
                  </ItemsControl.ItemTemplate>
                </ItemsControl>
                <CheckBox Name="CloneClearCamo" IsChecked="{Binding ClearCamo}" IsVisible="{Binding HasCamo}">
                  <TextBlock Text="Leave the camo out (a camo the map doesn't define can't be used)" Foreground="{DynamicResource TextSoftBrush}" TextWrapping="Wrap"/>
                </CheckBox>
              </StackPanel>
            </Grid>

            <!-- What comes with it -->
            <DockPanel DockPanel.Dock="Top" Margin="24,2,24,6">
              <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" Spacing="14" VerticalAlignment="Center">
                <StackPanel Orientation="Horizontal" Spacing="6">
                  <Ellipse Classes="actdot copy" Width="8" Height="8"/>
                  <TextBlock Classes="dim" FontSize="{StaticResource FontSizeSm}" Text="Copy, editable"/>
                </StackPanel>
                <StackPanel Orientation="Horizontal" Spacing="6">
                  <Ellipse Classes="actdot ship" Width="8" Height="8"/>
                  <TextBlock Classes="dim" FontSize="{StaticResource FontSizeSm}" Text="Use shipped"/>
                </StackPanel>
                <StackPanel Orientation="Horizontal" Spacing="6">
                  <Ellipse Classes="actdot rebuilt" Width="8" Height="8"/>
                  <TextBlock Classes="dim" FontSize="{StaticResource FontSizeSm}" Text="Rebuilt by linker"/>
                </StackPanel>
              </StackPanel>
              <TextBlock VerticalAlignment="Center">
                <Run Text="What comes with it" FontWeight="SemiBold"/><Run Text="   "/><Run Text="{Binding CountText, Mode=OneWay}" Foreground="{DynamicResource TextFaintBrush}"/>
              </TextBlock>
            </DockPanel>

            <StackPanel DockPanel.Dock="Bottom" Spacing="6" Margin="24,8,24,8">
              <Border Background="{DynamicResource BgFieldBrush}" BorderBrush="{DynamicResource LineBrush}" BorderThickness="1"
                      CornerRadius="{StaticResource RadiusMd}" Padding="12,9" IsVisible="{Binding HasNotes}">
                <TextBlock Name="CloneNotes" Classes="dim" FontSize="{StaticResource FontSizeSm}" TextWrapping="Wrap" Text="{Binding Notes}"/>
              </Border>
              <!-- Not available yet: greyed and inert (not focusable, not clickable), and says when it comes. -->
              <CheckBox Name="CloneKeepShipped" IsEnabled="False" IsChecked="False" Focusable="False" IsHitTestVisible="False" Opacity="0.4"
                        ToolTip.Tip="Not available yet: it needs the Rust linker, which keeps the compiled data a copy doesn't change.">
                <TextBlock Classes="faint" FontSize="{StaticResource FontSizeSm}" TextWrapping="Wrap"
                           Text="Keep the shipped compiled data for anything you don't edit (coming with the Rust linker)"/>
              </CheckBox>
            </StackPanel>

            <Grid Margin="24,0">
              <DockPanel>
                <Grid DockPanel.Dock="Top" ColumnDefinitions="*,150,210" Margin="10,4" >
                  <TextBlock Classes="faint" FontSize="{StaticResource FontSizeXs}" Text="Asset"/>
                  <TextBlock Grid.Column="1" Classes="faint" FontSize="{StaticResource FontSizeXs}" Text="Ships in"/>
                  <TextBlock Grid.Column="2" Classes="faint" FontSize="{StaticResource FontSizeXs}" Text="Action"/>
                </Grid>
                <Border DockPanel.Dock="Top" Height="1" Background="{DynamicResource LineBrush}"/>
                <ListBox Name="CloneRows" Classes="clonerows" ItemsSource="{Binding Rows}" SelectionMode="Single" Focusable="False">
                  <ListBox.ItemTemplate>
                    <DataTemplate x:DataType="vm:CloneDepRow">
                      <Grid ColumnDefinitions="*,150,210" Height="32" Background="Transparent" ToolTip.Tip="{Binding Tip}">
                        <DockPanel Margin="{Binding Indent}">
                          <Button DockPanel.Dock="Left" Classes="chev" Content="{Binding Chevron}" Command="{Binding ToggleCommand}" IsVisible="{Binding IsGroup}"
                                  AutomationProperties.Name="Expand or collapse"/>
                          <Panel DockPanel.Dock="Left" Width="24" IsVisible="{Binding !IsGroup}"/>
                          <Rectangle DockPanel.Dock="Left" Width="8" Height="8" RadiusX="2" RadiusY="2" Fill="{Binding DotBrush}" VerticalAlignment="Center" Margin="0,0,8,0"/>
                          <TextBlock VerticalAlignment="Center" TextTrimming="CharacterEllipsis" FontSize="{StaticResource FontSizeBase}">
                            <Run Text="{Binding Name, Mode=OneWay}" FontStyle="Italic" Foreground="{DynamicResource TextSoftBrush}"/><Run Text="   "/><Run Text="{Binding Meta, Mode=OneWay}" Foreground="{DynamicResource TextFaintBrush}" FontSize="{StaticResource FontSizeSm}"/>
                          </TextBlock>
                        </DockPanel>
                        <TextBlock Grid.Column="1" Classes="mono dim" FontSize="{StaticResource FontSizeSm}" Text="{Binding Zone}" VerticalAlignment="Center"
                                   TextTrimming="CharacterEllipsis"/>
                        <StackPanel Grid.Column="2" Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
                          <Ellipse Classes="actdot" Classes.copy="{Binding IsCopy}" Classes.ship="{Binding IsShip}" Classes.rebuilt="{Binding IsRebuilt}" Classes.odd="{Binding IsOdd}"
                                   Width="8" Height="8"/>
                          <Border Classes="actpill" Classes.rebuilt="{Binding IsRebuilt}">
                            <TextBlock Text="{Binding ActionLabel}" FontSize="{StaticResource FontSizeSm}"/>
                          </Border>
                        </StackPanel>
                      </Grid>
                    </DataTemplate>
                  </ListBox.ItemTemplate>
                </ListBox>
              </DockPanel>
              <StackPanel IsVisible="{Binding IsPlanning}" VerticalAlignment="Center" HorizontalAlignment="Center" Spacing="8" MinWidth="240">
                <ProgressBar IsIndeterminate="True" Height="4"/>
                <TextBlock Classes="dim" FontSize="{StaticResource FontSizeBase}" HorizontalAlignment="Center" Text="Reading dependencies from the game's files…"/>
              </StackPanel>
            </Grid>
          </DockPanel>

          <!-- Nothing to plan: no map to copy into, or the helper failed -->
          <StackPanel IsVisible="{Binding IsFailed}" Margin="24,28" Spacing="8">
            <TextBlock FontWeight="SemiBold" FontSize="{StaticResource FontSizeMd}" Text="Can't make a copy yet"/>
            <TextBlock Name="CloneFailText" Foreground="{DynamicResource DangerTextBrush}" TextWrapping="Wrap" Text="{Binding Error}"/>
          </StackPanel>
        </DockPanel>
      </Border>
    </Border>

    <!-- ── Create local copy of a stock sound: the audio into sound_assets, the alias rows into a soundalias CSV ── -->
    <Border Grid.Row="0" Grid.RowSpan="3" Classes="dialogbackdrop" IsVisible="{Binding IsSoundCopyOpen}" PointerPressed="SoundCopyBackdrop_PointerPressed">
      <Border Name="SoundCopyCard" Classes="dialogcard" Width="760" Padding="0" PointerPressed="PaletteCard_PointerPressed"
              KeyboardNavigation.TabNavigation="Cycle" DataContext="{Binding SoundCopyDialog}" x:DataType="vm:StockSoundCopyViewModel">
        <DockPanel>
          <Border DockPanel.Dock="Top" BorderBrush="{DynamicResource LineBrush}" BorderThickness="0,0,0,1" Padding="24,18,20,14">
            <StackPanel Spacing="4">
              <DockPanel>
                <Button DockPanel.Dock="Right" Name="SoundCopyCloseButton" Classes="icon" Content="✕" Command="{Binding CloseCommand}"
                        AutomationProperties.Name="Close" ToolTip.Tip="Close"/>
                <TextBlock FontWeight="SemiBold" FontSize="{StaticResource FontSizeMd}" Text="Create local copy" VerticalAlignment="Center"/>
              </DockPanel>
              <TextBlock Name="SoundCopySubtitle" Classes="dim" FontSize="{StaticResource FontSizeBase}" TextTrimming="CharacterEllipsis">
                <Run Text="{Binding Alias, Mode=OneWay}" FontStyle="Italic" Foreground="{DynamicResource TextSoftBrush}"/><Run Text="  ·  sound  ·  "/><Run Text="{Binding Subtitle, Mode=OneWay}"/>
              </TextBlock>
            </StackPanel>
          </Border>

          <Border DockPanel.Dock="Bottom" BorderBrush="{DynamicResource LineBrush}" BorderThickness="0,1,0,0" Padding="24,12">
            <DockPanel>
              <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" Spacing="8" VerticalAlignment="Center" Margin="16,0,0,0">
                <Button Name="SoundCopyUndoButton" Classes="outline" Command="{Binding UndoCommand}" IsVisible="{Binding ShowResult}" IsEnabled="{Binding CanUndo}">
                  <TextBlock Text="Undo"/>
                </Button>
                <Button Name="SoundCopyCancelButton" Classes="outline" Command="{Binding CloseCommand}" IsVisible="{Binding !ShowResult}" IsEnabled="{Binding !IsRunning}">
                  <TextBlock Text="Cancel"/>
                </Button>
                <Button Name="SoundCopyCreateButton" Classes="accent" Command="{Binding CreateCommand}" IsVisible="{Binding !ShowResult}" IsEnabled="{Binding CanCreate}">
                  <TextBlock Text="{Binding CreateLabel}"/>
                </Button>
                <Button Name="SoundCopyDoneButton" Classes="accent" Command="{Binding CloseCommand}" IsVisible="{Binding ShowResult}">
                  <TextBlock Text="Done"/>
                </Button>
              </StackPanel>
              <StackPanel IsVisible="{Binding IsRunning}" VerticalAlignment="Center" Spacing="4">
                <ProgressBar Height="4" Minimum="0" Maximum="1" Value="{Binding ProgressFraction}"/>
                <TextBlock Name="SoundCopyProgressText" Classes="dim" FontSize="{StaticResource FontSizeSm}" Text="{Binding ProgressText}" TextTrimming="CharacterEllipsis"/>
              </StackPanel>
              <TextBlock Name="SoundCopyProblem" FontSize="{StaticResource FontSizeSm}" VerticalAlignment="Center" TextWrapping="Wrap" MaxLines="2"
                         Foreground="{DynamicResource DangerTextBrush}" Text="{Binding Problem}" IsVisible="{Binding HasProblem}"/>
              <TextBlock Name="SoundCopyError" FontSize="{StaticResource FontSizeSm}" VerticalAlignment="Center" TextWrapping="Wrap" MaxLines="2"
                         Foreground="{DynamicResource DangerTextBrush}" Text="{Binding Error}" IsVisible="{Binding !!Error.Length}"/>
            </DockPanel>
          </Border>

          <Panel>
          <!-- After the copy -->
          <StackPanel Name="SoundCopyResult" IsVisible="{Binding ShowResult}" Spacing="14" Margin="24,20">
            <StackPanel Spacing="4">
              <TextBlock Name="SoundCopyResultTitle" FontWeight="SemiBold" FontSize="{StaticResource FontSizeMd}" Text="{Binding ResultTitle}"/>
              <TextBlock Name="SoundCopyResultDetail" Classes="dim" FontSize="{StaticResource FontSizeBase}" TextWrapping="Wrap" Text="{Binding ResultDetail}"/>
            </StackPanel>
            <TextBlock Name="SoundCopyAfter" Classes="faint" FontSize="{StaticResource FontSizeSm}" TextWrapping="Wrap" Text="{Binding AfterText}"/>
          </StackPanel>

          <!-- Before the copy -->
          <StackPanel IsVisible="{Binding ShowPlan}" Spacing="14" Margin="24,16,24,18">
            <StackPanel Spacing="6">
              <TextBlock Classes="dim" FontSize="{StaticResource FontSizeSm}" Text="Add the alias to"/>
              <DockPanel>
                <Button DockPanel.Dock="Right" Name="SoundCopyBrowse" Classes="outline" Margin="8,0,0,0" Command="{Binding BrowseCommand}" IsEnabled="{Binding !IsRunning}"
                        AutomationProperties.Name="Choose another alias file">
                  <TextBlock Text="Browse…"/>
                </Button>
                <ComboBox Name="SoundCopyCsvBox" Classes="field" HorizontalAlignment="Stretch" ItemsSource="{Binding Choices}" SelectedItem="{Binding Csv}"
                          IsEnabled="{Binding !IsRunning}" AutomationProperties.Name="Soundalias CSV">
                  <ComboBox.ItemTemplate>
                    <DataTemplate x:DataType="vm:SoundCsvChoice">
                      <TextBlock FontSize="{StaticResource FontSizeSm}" TextTrimming="CharacterEllipsis">
                        <Run Text="{Binding Label, Mode=OneWay}" FontFamily="{StaticResource MonoFont}"/><Run Text="  "/><Run Text="{Binding Detail, Mode=OneWay}" Foreground="{DynamicResource TextFaintBrush}"/>
                      </TextBlock>
                    </DataTemplate>
                  </ComboBox.ItemTemplate>
                </ComboBox>
              </DockPanel>
            </StackPanel>

            <StackPanel Spacing="6" IsVisible="{Binding HasManyVariants}">
              <TextBlock Classes="dim" FontSize="{StaticResource FontSizeSm}" Text="Variants"/>
              <RadioButton Name="SoundCopyAllVariants" GroupName="SoundCopyVariants" IsChecked="{Binding AllVariants}" IsEnabled="{Binding !IsRunning}">
                <TextBlock Text="{Binding AllVariantsText}" Foreground="{DynamicResource TextSoftBrush}"/>
              </RadioButton>
              <RadioButton Name="SoundCopyOneVariant" GroupName="SoundCopyVariants" IsChecked="{Binding OnlyOne}" IsEnabled="{Binding !IsRunning}">
                <TextBlock Text="{Binding OneVariantText}" Foreground="{DynamicResource TextSoftBrush}"/>
              </RadioButton>
            </StackPanel>

            <StackPanel Spacing="6">
              <TextBlock Classes="dim" FontSize="{StaticResource FontSizeSm}" Text="The audio goes to"/>
              <Border Background="{DynamicResource BgFieldBrush}" BorderBrush="{DynamicResource LineBrush}" BorderThickness="1"
                      CornerRadius="{StaticResource RadiusMd}" Padding="10,6">
                <TextBlock Name="SoundCopyFiles" Classes="dim" FontFamily="{StaticResource MonoFont}" FontSize="{StaticResource FontSizeSm}" TextTrimming="CharacterEllipsis">
                  <Run Text="{Binding AudioFolder, Mode=OneWay}"/><Run Text="{Binding FilesText, Mode=OneWay}"/>
                </TextBlock>
              </Border>
            </StackPanel>

            <StackPanel Spacing="6">
              <TextBlock Classes="dim" FontSize="{StaticResource FontSizeSm}" Text="The rows it adds"/>
              <Border Background="{DynamicResource BgFieldBrush}" BorderBrush="{DynamicResource LineBrush}" BorderThickness="1"
                      CornerRadius="{StaticResource RadiusMd}" Padding="10,8" MaxHeight="150">
                <ScrollViewer HorizontalScrollBarVisibility="Auto" VerticalScrollBarVisibility="Auto">
                  <SelectableTextBlock Name="SoundCopyRows" FontFamily="{StaticResource MonoFont}" FontSize="{StaticResource FontSizeSm}" Text="{Binding RowsText}"/>
                </ScrollViewer>
              </Border>
            </StackPanel>

            <TextBlock Classes="faint" FontSize="{StaticResource FontSizeSm}" TextWrapping="Wrap"
                       Text="The audio is the bank's own stream, untouched. The alias's mix settings (volume, distance, pan, ducks) aren't read from the game's banks, so the rows leave them at the soundalias defaults and use Bus bus_fx."/>
          </StackPanel>
          </Panel>
        </DockPanel>
      </Border>
    </Border>

    <!-- ── The stock helper: where its stocklib.exe is ──
         TODO(release feed): the helper has no release feed yet, so Install points Apex at a stocklib.exe on this machine. -->
    <Border Grid.Row="0" Grid.RowSpan="3" Classes="dialogbackdrop" IsVisible="{Binding IsStockHelperOpen}" PointerPressed="StockHelperBackdrop_PointerPressed">
      <Border Name="StockHelperCard" Classes="dialogcard" Width="540" PointerPressed="PaletteCard_PointerPressed" KeyboardNavigation.TabNavigation="Cycle">
        <StackPanel Spacing="12">
          <TextBlock FontWeight="SemiBold" FontSize="{StaticResource FontSizeMd}" Text="Stock helper"/>
          <TextBlock Classes="dim" FontSize="{StaticResource FontSizeBase}" TextWrapping="Wrap"
                     Text="The BO3 Mod Tools stock helper (stocklib.exe) reads the game's own fastfiles so Apex can search them and copy any of them into a map. There is no download for it yet: point Apex at the stocklib.exe you have."/>
          <DockPanel>
            <Button DockPanel.Dock="Right" Name="StockHelperBrowse" Classes="outline" Margin="8,0,0,0" Click="StockHelperBrowse_Click" AutomationProperties.Name="Browse for stocklib.exe">
              <TextBlock Text="Browse…"/>
            </Button>
            <TextBox Name="StockHelperBox" Classes="field" FontFamily="{StaticResource MonoFont}" Text="{Binding StockHelperPath}"
                     PlaceholderText="Path to stocklib.exe" AutomationProperties.Name="Path to stocklib.exe">
              <TextBox.KeyBindings>
                <KeyBinding Gesture="Enter" Command="{Binding AcceptStockHelperCommand}"/>
              </TextBox.KeyBindings>
            </TextBox>
          </DockPanel>
          <TextBlock FontSize="{StaticResource FontSizeSm}" Foreground="{DynamicResource DangerTextBrush}" TextWrapping="Wrap"
                     Text="{Binding StockHelperError}" IsVisible="{Binding !!StockHelperError.Length}"/>
          <StackPanel Orientation="Horizontal" Spacing="8" HorizontalAlignment="Right">
            <Button Classes="outline" Command="{Binding CancelStockHelperCommand}"><TextBlock Text="Cancel"/></Button>
            <Button Name="StockHelperAccept" Classes="accent" Command="{Binding AcceptStockHelperCommand}"><TextBlock Text="Use this helper"/></Button>
          </StackPanel>
        </StackPanel>
      </Border>
    </Border>

    <!-- ── Rename (F2) ───────────────────────────────────────────── -->
    <Border Grid.Row="0" Grid.RowSpan="3" Classes="dialogbackdrop" IsVisible="{Binding IsRenameOpen}"
            PointerPressed="RenameBackdrop_PointerPressed">
      <Border Name="RenameCard" Classes="dialogcard" PointerPressed="PaletteCard_PointerPressed" KeyboardNavigation.TabNavigation="Cycle">
        <StackPanel Spacing="10">
          <TextBlock FontWeight="SemiBold" FontSize="{StaticResource FontSizeMd}" Text="Rename asset"/>
          <TextBlock Classes="dim" FontSize="{StaticResource FontSizeSm}" TextWrapping="Wrap"
                     Text="Lowercase letters, digits and underscores. A space types an underscore."/>
          <TextBox Name="RenameBox" Classes="field" FontFamily="{StaticResource MonoFont}" Text="{Binding ActiveTab.RenameText}"
                   AutomationProperties.Name="New name">
            <TextBox.KeyBindings>
              <KeyBinding Gesture="Enter" Command="{Binding CommitRenameCommand}"/>
            </TextBox.KeyBindings>
          </TextBox>
          <!-- One reserved line: why the name can't be used, or what renaming will touch (blast radius
               stated before the fact, from a scan of every GDT). -->
          <Panel MinHeight="16">
            <TextBlock FontSize="{StaticResource FontSizeSm}" Foreground="{DynamicResource DangerTextBrush}" TextWrapping="Wrap"
                       Text="{Binding RenameError}" IsVisible="{Binding !!RenameError.Length}" AutomationProperties.LiveSetting="Assertive"/>
            <TextBlock Classes="faint" FontSize="{StaticResource FontSizeSm}" TextWrapping="Wrap"
                       Text="{Binding RenameNote}" IsVisible="{Binding !RenameError.Length}" AutomationProperties.LiveSetting="Polite"/>
          </Panel>
          <StackPanel Orientation="Horizontal" Spacing="8" HorizontalAlignment="Right">
            <Button Classes="outline" Content="Cancel" Command="{Binding CancelRenameCommand}"/>
            <Button Classes="accent" Command="{Binding CommitRenameCommand}">
              <TextBlock Text="Rename"/>
            </Button>
          </StackPanel>
        </StackPanel>
      </Border>
    </Border>

    <!-- ── New asset (Ctrl+N) / New GDT ──────────────────────────── -->
    <Border Grid.Row="0" Grid.RowSpan="3" Classes="dialogbackdrop" IsVisible="{Binding IsNewOpen}"
            PointerPressed="NewBackdrop_PointerPressed">
      <Border Name="NewCard" Classes="dialogcard" PointerPressed="PaletteCard_PointerPressed" KeyboardNavigation.TabNavigation="Cycle">
        <StackPanel Spacing="10">
          <TextBlock FontWeight="SemiBold" FontSize="{StaticResource FontSizeMd}" Text="{Binding NewTitle}"/>
          <TextBlock Classes="dim" FontSize="{StaticResource FontSizeSm}" TextWrapping="Wrap"
                     Text="Lowercase letters, digits and underscores. A space types an underscore."/>
          <TextBox Name="NewNameBox" Classes="field" FontFamily="{StaticResource MonoFont}" Text="{Binding NewName}"
                   AutomationProperties.Name="Name">
            <TextBox.KeyBindings>
              <KeyBinding Gesture="Enter" Command="{Binding CommitNewCommand}"/>
            </TextBox.KeyBindings>
          </TextBox>
          <Grid ColumnDefinitions="Auto,12,*" RowDefinitions="Auto,8,Auto" IsVisible="{Binding NewIsAsset}">
            <TextBlock Classes="dim" FontSize="{StaticResource FontSizeSm}" Text="Type" VerticalAlignment="Center"/>
            <ComboBox Grid.Column="2" Name="NewTypeBox" Classes="field" HorizontalAlignment="Stretch"
                      ItemsSource="{Binding NewTypeChoices}" SelectedItem="{Binding NewType}" AutomationProperties.Name="Type"/>
            <!-- Hundreds of GDTs: a search over a short list, short names first, rather than a dropdown of paths. -->
            <TextBlock Grid.Row="2" Classes="dim" FontSize="{StaticResource FontSizeSm}" Text="GDT" VerticalAlignment="Top" Margin="0,6,0,0"/>
            <StackPanel Grid.Row="2" Grid.Column="2" Spacing="4">
              <TextBox Name="NewGdtSearch" Classes="field" Text="{Binding NewGdtFilter}" PlaceholderText="Search GDTs"
                       AutomationProperties.Name="Search GDTs">
                <TextBox.KeyBindings>
                  <KeyBinding Gesture="Down" Command="{Binding NewGdtNextCommand}"/>
                  <KeyBinding Gesture="Up" Command="{Binding NewGdtPreviousCommand}"/>
                  <KeyBinding Gesture="Enter" Command="{Binding CommitNewCommand}"/>
                </TextBox.KeyBindings>
              </TextBox>
              <ListBox Name="NewGdtList" Classes="palette" Height="148" ItemsSource="{Binding NewGdtMatches}"
                       SelectedItem="{Binding NewGdtChoice}" AutomationProperties.Name="GDT">
                <ListBox.ItemTemplate>
                  <DataTemplate x:DataType="vm:GdtChoice">
                    <Grid ColumnDefinitions="Auto,*,Auto" ToolTip.Tip="{Binding Name}">
                      <TextBlock Classes="mono" FontSize="{StaticResource FontSizeSm}" Text="{Binding Short}" VerticalAlignment="Center"/>
                      <TextBlock Grid.Column="1" Classes="faint" FontSize="{StaticResource FontSizeXs}" Text="{Binding Folder}"
                                 VerticalAlignment="Center" Margin="10,0,0,0" TextTrimming="LeadingCharacterEllipsis"/>
                      <TextBlock Grid.Column="2" Classes="faint" FontSize="{StaticResource FontSizeXs}" Text="{Binding Detail}"
                                 VerticalAlignment="Center" Margin="10,0,0,0"/>
                    </Grid>
                  </DataTemplate>
                </ListBox.ItemTemplate>
              </ListBox>
            </StackPanel>
          </Grid>
          <TextBlock MinHeight="16" FontSize="{StaticResource FontSizeSm}" Foreground="{DynamicResource DangerTextBrush}" TextWrapping="Wrap"
                     Text="{Binding NewError}" AutomationProperties.LiveSetting="Assertive"/>
          <StackPanel Orientation="Horizontal" Spacing="8" HorizontalAlignment="Right">
            <Button Classes="outline" Content="Cancel" Command="{Binding CancelNewCommand}"/>
            <Button Classes="accent" Command="{Binding CommitNewCommand}">
              <TextBlock Text="Create"/>
            </Button>
          </StackPanel>
        </StackPanel>
      </Border>
    </Border>

    <!-- ── Quick Open (Ctrl+P) · > commands · @ properties ──────── -->
    <Border Grid.Row="0" Grid.RowSpan="3" Background="{DynamicResource ScrimLightBrush}" IsVisible="{Binding IsPaletteOpen}"
            PointerPressed="PaletteBackdrop_PointerPressed">
      <Border Width="600" MaxHeight="460" VerticalAlignment="Top" Margin="0,48,0,0"
              Background="{DynamicResource BgCardBrush}" BorderBrush="{DynamicResource LineBrush}"
              BorderThickness="1" CornerRadius="{StaticResource RadiusOverlay}" Padding="6" BoxShadow="{DynamicResource ShadowDialog}"
              PointerPressed="PaletteCard_PointerPressed" KeyboardNavigation.TabNavigation="Cycle">
        <DockPanel>
          <TextBox Name="PaletteBox" DockPanel.Dock="Top" Classes="field" FontSize="{StaticResource FontSizeBase}"
                   Text="{Binding PaletteText}" AutomationProperties.Name="{Binding PalettePlaceholder}"
                   PlaceholderText="{Binding PalettePlaceholder}">
            <TextBox.InnerLeftContent>
              <TextBlock Text="⌕" FontSize="{StaticResource FontSizeMd}" Classes="dim" Margin="4,0,0,0" VerticalAlignment="Center"/>
            </TextBox.InnerLeftContent>
            <TextBox.KeyBindings>
              <KeyBinding Gesture="Enter" Command="{Binding ConfirmPaletteCommand}"/>
              <KeyBinding Gesture="Escape" Command="{Binding ClosePaletteCommand}"/>
              <KeyBinding Gesture="Down" Command="{Binding PaletteNextCommand}"/>
              <KeyBinding Gesture="Up" Command="{Binding PalettePrevCommand}"/>
            </TextBox.KeyBindings>
          </TextBox>
          <TextBlock DockPanel.Dock="Bottom" Classes="faint" FontSize="{StaticResource FontSizeXs}" Margin="8,7,6,3"
                     Text="{Binding PaletteHint}"/>
          <ListBox Name="PaletteList" Classes="palette" Margin="0,6,0,0"
                   ItemsSource="{Binding PaletteRows}" SelectedIndex="{Binding PaletteSelectedIndex}"
                   PointerReleased="PaletteList_PointerReleased">
            <ListBox.Styles>
              <!-- Lines the current results don't need stay built but hidden (see PaletteRow). -->
              <Style Selector="ListBoxItem" x:DataType="vm:PaletteRow">
                <Setter Property="IsVisible" Value="{Binding IsShown}"/>
                <Setter Property="AutomationProperties.Name" Value="{Binding AccessibleName}"/>
              </Style>
            </ListBox.Styles>
            <ListBox.ItemTemplate>
              <DataTemplate x:DataType="vm:PaletteRow">
                <!-- A hidden line has no Item: its DataContext is null, so these bindings rest instead of failing. -->
                <DockPanel DataContext="{Binding Item}" x:DataType="vm:PaletteItemViewModel">
                  <TextBlock DockPanel.Dock="Left" Text="{Binding Glyph}" Foreground="{Binding GlyphBrush}"
                             Width="22" FontSize="{StaticResource FontSizeSm}" VerticalAlignment="Center"/>
                  <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
                    <TextBlock Classes="faint" FontSize="{StaticResource FontSizeXs}" Text="{Binding TypeName}" IsVisible="{Binding IsAsset}"/>
                    <TextBlock Classes="faint" FontSize="{StaticResource FontSizeXs}" Text="{Binding GdtName}" IsVisible="{Binding IsAsset}"/>
                    <TextBlock Classes="faint" FontSize="{StaticResource FontSizeXs}" Text="{Binding Detail}"/>
                    <TextBlock Classes="faint" FontSize="{StaticResource FontSizeXs}" Text="{Binding Shortcut}"/>
                  </StackPanel>
                  <TextBlock Classes.mono="{Binding IsAsset}" FontSize="{StaticResource FontSizeBase}" Text="{Binding Name}"
                             TextTrimming="CharacterEllipsis" VerticalAlignment="Center"/>
                </DockPanel>
              </DataTemplate>
            </ListBox.ItemTemplate>
          </ListBox>
        </DockPanel>
      </Border>
    </Border>

  </Grid>
  </Panel>
</Window>
