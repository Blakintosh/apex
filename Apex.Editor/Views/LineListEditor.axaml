<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:Apex.Editor.ViewModels"
             xmlns:controls="using:Apex.Editor.Controls"
             xmlns:c="using:Apex.Editor.Commands"
             xmlns:views="using:Apex.Editor.Views"
             x:Class="Apex.Editor.Views.LineListEditor"
             x:DataType="vm:LinesPropertyViewModel"
             Focusable="False">

  <!--
    A line-list field (hideTags, xmodel materials and skinOverride, comments…): one row per item and an "Add" field at
    the end. skinOverride lists every surface material of the model (its LODs too), as APE does, each as a material slot
    (what draws there, and a Replace menu); it has pair rows and an Add field only when the model file can't be read.
    Each item edits like the field it holds (a material suggests materials, a tag suggests the model's bones)
    and commits like any text field (Enter or focus loss; Esc reverts). Enter moves on to the next item, Delete in an
    empty item removes it, ↑↓ walk the items. Past eight items (twenty slots) the list scrolls. In a table cell the list is a one-line
    summary ("3 tags") that opens it below the cell.
  -->
  <UserControl.Styles>
    <!--
      ✕ draws on the hovered or focused item only; its column keeps its width, so nothing moves when it shows. Only its
      glyph hides, and it acts on press: clicking ✕ again where the next item has just moved up (the row's hover doesn't
      update until the mouse moves) removes that one too.
    -->
    <Style Selector="Grid.litem Button.lremove">
      <Setter Property="Foreground" Value="Transparent"/>
    </Style>
    <!-- skinOverride's halves share a narrow row: a field never asks for more than its half (it scrolls its text). -->
    <Style Selector="Grid.litem TextBox">
      <Setter Property="MinWidth" Value="0"/>
    </Style>
    <Style Selector="Grid.litem:pointerover Button.lremove, Grid.litem:focus-within Button.lremove">
      <Setter Property="Foreground" Value="{DynamicResource TextDimBrush}"/>
    </Style>
    <!-- A material slot's face (swatch and name) opens what draws there: a link, not a field. It never fills; the name
         underlines under the pointer. A slot with nothing to open (hidden, or a material that isn't loaded) looks the
         same, it just doesn't open. -->
    <Style Selector="Button.lslotface">
      <Setter Property="Background" Value="Transparent"/>
      <Setter Property="BorderThickness" Value="0"/>
      <Setter Property="Padding" Value="2"/>
      <Setter Property="HorizontalAlignment" Value="Stretch"/>
      <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
      <Setter Property="Cursor" Value="Hand"/>
    </Style>
    <Style Selector="Button.lslotface:pointerover /template/ ContentPresenter, Button.lslotface:pressed /template/ ContentPresenter,
                     Button.lslotface:disabled /template/ ContentPresenter">
      <Setter Property="Background" Value="Transparent"/>
    </Style>
    <Style Selector="Button.lslotface:disabled">
      <Setter Property="Opacity" Value="1"/>
      <Setter Property="Cursor" Value="Arrow"/>
    </Style>
    <Style Selector="Button.lslotface:pointerover TextBlock.lslotname">
      <Setter Property="TextDecorations" Value="Underline"/>
    </Style>
    <Style Selector="Border.lswatch">
      <Setter Property="Width" Value="32"/>
      <Setter Property="Height" Value="32"/>
      <Setter Property="CornerRadius" Value="{StaticResource RadiusXs}"/>
      <Setter Property="ClipToBounds" Value="True"/>
      <Setter Property="Background" Value="{DynamicResource BgFieldBrush}"/>
      <Setter Property="BorderBrush" Value="{DynamicResource LineBrush}"/>
      <Setter Property="BorderThickness" Value="1"/>
    </Style>
    <!-- Hidden: the swatch is covered, the eye crossed out. -->
    <Style Selector="Border.lswatchhidden">
      <Setter Property="Background" Value="{DynamicResource BgFieldBrush}"/>
    </Style>
    <!-- The name is what draws (nodraw, dim, while hidden), trimmed from the front: a model's materials often share a
         long prefix and differ at the end (…_image_off, …_image_on). -->
    <Style Selector="TextBlock.lslotname">
      <Setter Property="FontFamily" Value="{StaticResource MonoFont}"/>
      <Setter Property="FontSize" Value="{StaticResource FontSizeBase}"/>
      <Setter Property="Foreground" Value="{DynamicResource TextBrush}"/>
      <Setter Property="TextTrimming" Value="PrefixCharacterEllipsis"/>
    </Style>
    <Style Selector="TextBlock.lslotname.hidden">
      <Setter Property="Foreground" Value="{DynamicResource TextDimBrush}"/>
    </Style>
    <!-- An override's second line: the model's own material, struck through. -->
    <Style Selector="TextBlock.lslotoriginal">
      <Setter Property="FontFamily" Value="{StaticResource MonoFont}"/>
      <Setter Property="FontSize" Value="{StaticResource FontSizeXs}"/>
      <Setter Property="Foreground" Value="{DynamicResource TextFaintBrush}"/>
      <Setter Property="TextDecorations" Value="Strikethrough"/>
      <Setter Property="TextTrimming" Value="PrefixCharacterEllipsis"/>
    </Style>
    <Style Selector="Border.lchip">
      <Setter Property="Padding" Value="6,1"/>
      <Setter Property="CornerRadius" Value="{StaticResource RadiusXs}"/>
      <Setter Property="Background" Value="{DynamicResource BgFieldBrush}"/>
      <Setter Property="VerticalAlignment" Value="Center"/>
    </Style>
    <Style Selector="Border.lchip TextBlock">
      <Setter Property="FontSize" Value="{StaticResource FontSizeXs}"/>
      <Setter Property="Foreground" Value="{DynamicResource TextDimBrush}"/>
    </Style>
    <Style Selector="Border.lchip.override">
      <Setter Property="Background" Value="{DynamicResource AccentDimBrush}"/>
    </Style>
    <Style Selector="Border.lchip.override TextBlock">
      <Setter Property="Foreground" Value="{DynamicResource AccentTextBrush}"/>
    </Style>
    <!-- Replace ▾: the app's menu button, with a hairline so it reads as the slot's control at rest. -->
    <Style Selector="Button.lreplace">
      <Setter Property="BorderThickness" Value="1"/>
      <Setter Property="BorderBrush" Value="{DynamicResource LineBrush}"/>
      <Setter Property="FontSize" Value="{StaticResource FontSizeSm}"/>
    </Style>
  </UserControl.Styles>

  <UserControl.DataTemplates>
    <DataTemplate DataType="vm:RefPropertyViewModel">
      <Grid>
        <views:RefField Classes="pfield mono" Text="{Binding Value, Mode=OneWay}" Padding="26,0,2,0" IsUndoEnabled="False"/>
        <TextBlock Text="{Binding RefGlyph}" Foreground="{Binding RefBrush}" FontSize="{StaticResource FontSizeXs}" Margin="9,0,0,0"
                   VerticalAlignment="Center" HorizontalAlignment="Left" IsHitTestVisible="False" ToolTip.Tip="{Binding RefType}"/>
        <!-- Left of the field's own ▾ (a name with a problem doesn't resolve, so its open arrow isn't there). -->
        <TextBlock Text="⚠" Classes="problem" FontSize="{StaticResource FontSizeSm}" HorizontalAlignment="Right" VerticalAlignment="Center"
                   Margin="0,0,28,0" IsVisible="{Binding HasProblem}" ToolTip.Tip="{Binding Problem}"/>
      </Grid>
    </DataTemplate>
    <DataTemplate DataType="vm:SuggestPropertyViewModel">
      <controls:SuggestBox/>
    </DataTemplate>
    <DataTemplate DataType="vm:TextPropertyViewModel">
      <TextBox Classes="pfield" Text="{Binding Value, Mode=OneWay}" IsUndoEnabled="False"/>
    </DataTemplate>

    <DataTemplate DataType="vm:LineItemViewModel">
      <Panel>
      <!--
        A surface of the model is a material slot: what draws there leads (its swatch and name, which open it), an
        override has the model's own material under it, struck through, and Replace ▾ chooses, hides or resets it. The
        material field shows only while choosing.
      -->
      <Grid Classes="lslot" ColumnDefinitions="*,Auto" Margin="0,0,0,2" IsVisible="{Binding IsModelSurface}">
        <Panel>
          <Button Classes="lslotface" Command="{Binding OpenCommand}" Focusable="False" IsVisible="{Binding !IsChoosing}"
                  ToolTip.Tip="{Binding Shown, StringFormat='Open {0}'}"
                  AutomationProperties.Name="{Binding Shown, StringFormat='Open {0}'}">
            <Grid ColumnDefinitions="Auto,*">
              <Border Classes="lswatch" Classes.hidden="{Binding IsHidden}">
                <Panel>
                  <Image Source="{Binding Thumbnail}" Stretch="UniformToFill" IsVisible="{Binding HasThumbnail}"/>
                  <TextBlock Text="{Binding SwatchGlyph}" Foreground="{Binding SwatchBrush}" FontSize="{StaticResource FontSizeSm}"
                             HorizontalAlignment="Center" VerticalAlignment="Center" IsVisible="{Binding !HasThumbnail}"
                             IsHitTestVisible="False"/>
                  <Border Classes="lswatchhidden" IsVisible="{Binding IsHidden}">
                    <controls:GlyphIcon Glyph="eye-off" Size="14" Foreground="{DynamicResource TextDimBrush}"
                                        HorizontalAlignment="Center" VerticalAlignment="Center"/>
                  </Border>
                </Panel>
              </Border>
              <StackPanel Grid.Column="1" Margin="10,0,0,0" VerticalAlignment="Center" Spacing="1">
                <TextBlock Classes="lslotname" Classes.hidden="{Binding IsHidden}" Text="{Binding Title}"/>
                <TextBlock Classes="lslotoriginal" Text="{Binding Surface}" IsVisible="{Binding IsOverridden}"/>
              </StackPanel>
            </Grid>
          </Button>
          <ContentControl Content="{Binding Replacement}" HorizontalContentAlignment="Stretch" VerticalAlignment="Center"
                          Focusable="False" IsVisible="{Binding IsChoosing}"/>
        </Panel>
        <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="6" VerticalAlignment="Center" Margin="8,0,0,0">
          <Border Classes="lchip override" IsVisible="{Binding IsReplaced}">
            <TextBlock Text="Override"/>
          </Border>
          <Border Classes="lchip" IsVisible="{Binding IsHidden}">
            <TextBlock Text="Hidden"/>
          </Border>
          <Button Classes="menu lreplace" AutomationProperties.Name="{Binding Surface, StringFormat='Replace {0}'}"
                  ToolTip.Tip="Choose, hide or reset this material (Delete resets it)">
            <StackPanel Orientation="Horizontal" Spacing="4">
              <TextBlock Text="Replace" VerticalAlignment="Center"/>
              <controls:GlyphIcon Glyph="chevron-down" Size="12" Foreground="{DynamicResource TextFaintBrush}" VerticalAlignment="Center"/>
            </StackPanel>
            <Button.Flyout>
              <MenuFlyout Placement="BottomEdgeAlignedRight">
                <MenuItem Header="Choose material…" Command="{Binding ChooseCommand}"/>
                <MenuItem Header="Hide (nodraw)" Command="{Binding HideCommand}"/>
                <MenuItem Header="Use the model's material" Command="{Binding ResetCommand}" InputGesture="Delete"/>
                <Separator/>
                <MenuItem Header="Open material" Command="{Binding OpenCommand}"/>
              </MenuFlyout>
            </Button.Flyout>
          </Button>
        </StackPanel>
      </Grid>
      <Grid Classes="litem" ColumnDefinitions="*,24" Margin="0,0,0,2" IsVisible="{Binding !IsModelSurface}">
        <!-- skinOverride (a surface the model doesn't list, or a model that can't be read): surface | replacement, half each. -->
        <UniformGrid Rows="1" Columns="{Binding Columns}">
          <ContentControl Content="{Binding Main}" HorizontalContentAlignment="Stretch" Focusable="False"/>
          <ContentControl Content="{Binding Replacement}" HorizontalContentAlignment="Stretch" Focusable="False" Margin="4,0,0,0"
                          IsVisible="{Binding IsPair}"/>
        </UniformGrid>
        <Button Grid.Column="1" Classes="rowaction lremove" Content="✕" Focusable="False" ClickMode="Press" IsVisible="{Binding CanRemove}"
                ToolTip.Tip="Remove" AutomationProperties.Name="Remove"/>
      </Grid>
      </Panel>
    </DataTemplate>
  </UserControl.DataTemplates>

  <Panel>
    <!-- A table cell: the count, which opens the list (built on first open). -->
    <Button Name="SummaryButton" Classes="lsummary" IsVisible="False" Height="24" MinHeight="24" Padding="8,0"
            HorizontalAlignment="Stretch" HorizontalContentAlignment="Left" VerticalContentAlignment="Center"
            Background="{DynamicResource BgFieldBrush}" ToolTip.Tip="{Binding ItemsTip}">
      <TextBlock Text="{Binding Summary}" FontFamily="{StaticResource MonoFont}" FontSize="{StaticResource FontSizeSm}"
                 TextTrimming="CharacterEllipsis"/>
    </Button>

    <!-- A grid, not a stack: a stack lays a child out at least as wide as it asks, and a slot asks for its whole name
         (its trimming only applies within the width it is given), so it would spill past the value column. -->
    <Grid Name="Full" RowDefinitions="Auto,Auto,Auto" Margin="0,3,0,1">
      <!-- A pair list says which side is which: the right is what replaces the left. -->
      <Grid ColumnDefinitions="*,24" Margin="0,0,0,2" IsVisible="{Binding ShowsPairTitles}">
        <UniformGrid Rows="1" Columns="2">
          <TextBlock Classes="faint" FontSize="{StaticResource FontSizeXs}" Text="{Binding SurfaceTitle}" Margin="8,0,0,0"/>
          <TextBlock Classes="faint" FontSize="{StaticResource FontSizeXs}" Text="{Binding ReplacementTitle}" Margin="12,0,0,0"/>
        </UniformGrid>
      </Grid>
      <ScrollViewer Grid.Row="1" Name="ItemsScroll" MaxHeight="{Binding MaxListHeight}" HorizontalScrollBarVisibility="Disabled">
        <ItemsControl Name="ItemsList" ItemsSource="{Binding Items}" Focusable="False"/>
      </ScrollViewer>
      <ContentControl Grid.Row="2" Name="AddRow" Content="{Binding AddItem}" HorizontalContentAlignment="Stretch" Focusable="False"
                      IsVisible="{Binding CanAdd}"/>
    </Grid>
  </Panel>
</UserControl>
