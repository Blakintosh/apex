<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:views="using:Apex.Editor.Views"
             x:Class="Apex.Editor.Views.RefSuggestPopup"
             Focusable="False">

  <!--
    The suggestions under a reference field: assets of the referenced type, the typed part of each name bold and
    underlined as in the Explorer, its GDT trailing. The keyboard stays in the field (see RefField): nothing here can
    take focus, and a click on a row picks it. The list shows ten lines and windows over the results: its lines keep
    their controls and only change what they show, so a keystroke rebinds a few texts instead of building rows, and
    "all 40,000 images" costs the same as ten.
  -->
  <UserControl.Resources>
    <TextDecorationCollection x:Key="HitUnderline">
      <TextDecoration Location="Underline" StrokeThickness="2" StrokeOffset="2" StrokeOffsetUnit="Pixel"/>
    </TextDecorationCollection>
  </UserControl.Resources>

  <Border Name="Card" Background="{DynamicResource BgCardBrush}" BorderBrush="{DynamicResource LineBrush}" BorderThickness="1"
          CornerRadius="{StaticResource RadiusOverlay}" Padding="4" BoxShadow="{DynamicResource ShadowLayer}">
    <Panel>
      <TextBlock Name="Message" Classes="faint" FontSize="{StaticResource FontSizeSm}" Margin="9,6" IsVisible="False"
                 TextTrimming="CharacterEllipsis"/>
      <DockPanel Name="Results">
        <ScrollBar Name="Scroll" DockPanel.Dock="Right" Orientation="Vertical" Margin="2,0,0,0" IsVisible="False"
                   AllowAutoHide="False" Focusable="False"/>
        <ListBox Name="Lines" Classes="palette" Focusable="False" AutomationProperties.Name="Suggestions"
                 ScrollViewer.VerticalScrollBarVisibility="Disabled" ScrollViewer.HorizontalScrollBarVisibility="Disabled">
          <ListBox.Styles>
            <!-- The keyboard never leaves the field, so no line takes focus; unused lines stay built but hidden. -->
            <Style Selector="ListBoxItem" x:DataType="views:RefSuggestLine">
              <Setter Property="Focusable" Value="False"/>
              <Setter Property="IsVisible" Value="{Binding IsShown}"/>
            </Style>
          </ListBox.Styles>
          <ListBox.ItemTemplate>
            <DataTemplate x:DataType="views:RefSuggestLine">
              <DockPanel>
                <TextBlock DockPanel.Dock="Left" Text="{Binding Glyph}" Foreground="{Binding GlyphBrush}" Width="18"
                           FontSize="{StaticResource FontSizeSm}" VerticalAlignment="Center" TextAlignment="Center" Margin="0,0,6,0"/>
                <TextBlock DockPanel.Dock="Right" Classes="faint" FontSize="{StaticResource FontSizeXs}" Text="{Binding Gdt}"
                           MaxWidth="150" TextTrimming="CharacterEllipsis" VerticalAlignment="Center" Margin="12,0,0,0"/>
                <TextBlock Classes="mono" FontSize="{StaticResource FontSizeSm}" VerticalAlignment="Center" TextTrimming="CharacterEllipsis">
                  <Run Text="{Binding Prefix, Mode=OneWay}"/><Run Text="{Binding Hit, Mode=OneWay}" FontWeight="SemiBold" TextDecorations="{StaticResource HitUnderline}"/><Run Text="{Binding Postfix, Mode=OneWay}"/>
                </TextBlock>
              </DockPanel>
            </DataTemplate>
          </ListBox.ItemTemplate>
        </ListBox>
      </DockPanel>
    </Panel>
  </Border>
</UserControl>
